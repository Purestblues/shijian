<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Token 统一汇总入口：尺寸、间距、字号、动效、海拔、颜色 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens/Radius.axaml" />
        <ResourceInclude Source="/Themes/Tokens/Space.axaml" />
        <ResourceInclude Source="/Themes/Tokens/Type.axaml" />
        <ResourceInclude Source="/Themes/Tokens/Motion.axaml" />
        <ResourceInclude Source="/Themes/Tokens/Elevation.axaml" />
        <ResourceInclude Source="/Themes/Tokens/Color.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
