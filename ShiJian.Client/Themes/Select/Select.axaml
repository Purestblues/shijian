<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:ShiJian.Client.Controls.Base"
                    xmlns:controls="using:ShiJian.Client.Controls.Select"
                    xmlns:behaviors="using:ShiJian.Client.Behaviors">


    <ControlTheme x:Key="{x:Type controls:Select}" TargetType="controls:Select">
        <Styles>
            <Style Selector="controls|Select:pointerover /template/ Border#Main">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
            </Style>
            <Style Selector="controls|Select[IsOpen=True] /template/ Border#Main">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
            </Style>
            <Style Selector="controls|Select[IsOpen=True] /template/ base|Icon#PopupIcon">
                <Setter Property="Foreground" Value="{DynamicResource ThemeBrush}" />
            </Style>
            <Style Selector="controls|Select[IsShowIcon=False]">
                <Style Selector="^ /template/ base|Img#Img">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>
        </Styles>
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border HorizontalAlignment="Left">
                    <Grid>
                        <Border x:Name="Main" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="1">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <base:Img x:Name="Img"
                                          URL="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:Select}}, 
										  Path=SelectedItem.Img}"
                                          DecodeWidth="16"
                                          Width="16" Height="16"
                                          VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:Select}}, Path=SelectedItem.Name}"
                                    FontSize="13"
                                    Foreground="{DynamicResource DefaultTextBrush}"
                                    VerticalAlignment="Center" />
                                <base:Icon x:Name="PopupIcon" Width="14" Height="14" Margin="2,0,0,0" FontSize="10"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           IconType="ChevronDown" VerticalAlignment="Center"
                                           RenderTransformOrigin=".5,.5">
                                    <base:Icon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </base:Icon.RenderTransform>
                                </base:Icon>
                            </StackPanel>
                        </Border>

                        <!--选择-->
                        <Popup
                            x:Name="PART_Popup"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=Main}"
                            IsLightDismissEnabled="True"
                            IsOpen="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:Select}}, Path=IsOpen,Mode=TwoWay}">
                            <Interaction.Behaviors>
                                <behaviors:PopupScrollDismissBehavior />
                            </Interaction.Behaviors>
                            <Border
                                CornerRadius="{StaticResource RadiusMedium}"
                                BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="1"
                                BoxShadow="{DynamicResource Elevation2}"
                                Background="{DynamicResource PopupBackgroundBrush}" Padding="6" MaxHeight="300"
                                Margin="8">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="OptionsContainer" Spacing="2" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>