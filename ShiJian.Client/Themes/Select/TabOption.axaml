<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:select="clr-namespace:ShiJian.Client.Controls.Select"
                    xmlns:base="clr-namespace:ShiJian.Client.Controls.Base">

    <ControlTheme x:Key="{x:Type select:TabOption}" TargetType="select:TabOption">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TabOptionTextColor}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        Cursor="Hand"
                        RenderTransform="scale(1)"
                        RenderTransformOrigin="50%,50%"
                        x:Name="RootBorder">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.40,0,0.20,1" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="0.40,0,0.20,1" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
                        <Border Grid.Column="0"
                                Margin="0,0,6,0"
                                x:Name="Img"
                                IsVisible="{Binding $parent[select:TabOption].IsShowIcon}">
                            <base:Img
                                URL="{Binding $parent[select:TabOption].Value.Img}"
                                DecodeWidth="14"
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                Text="{Binding $parent[select:TabOption].Value.Name}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                FontWeight="Medium"
                                FontSize="12" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Styles>
            <Style Selector="select|TabOption">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TabOptionTextColor}" />
            </Style>
            <Style Selector="select|TabOption TextBlock">
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="0.40,0,0.20,1" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="select|TabOption:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
            </Style>
            <Style Selector="select|TabOption:pressed /template/ Border#RootBorder">
                <Setter Property="RenderTransform" Value="scale(0.975)" />
            </Style>

            <Style Selector="select|TabOption[IsChecked=True]">
                <Setter Property="Foreground" Value="{DynamicResource ThemeBrush}" />
            </Style>
        </Styles>
    </ControlTheme>
</ResourceDictionary>
