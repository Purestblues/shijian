<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.DatePickerBar">

    <ControlTheme x:Key="{x:Type controls:DatePickerGridItem}" TargetType="controls:DatePickerGridItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Styles>
            <Style Selector="controls|DatePickerGridItem[IsSelected=True]">
                <Style Selector="^ /template/ Border#Bg">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush}" />
                </Style>

                <Style Selector="^ /template/ TextBlock#Text">
                    <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </Style>

            <Style Selector="controls|DatePickerGridItem:pointerover /template/ Border#Bg">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
            </Style>

            <Style Selector="controls|DatePickerGridItem[IsSelected=True]:pointerover /template/ Border#Bg">
                <Setter Property="Background" Value="{DynamicResource ThemeBrush}" />
            </Style>
            <Style Selector="controls|DatePickerGridItem:pressed /template/ Border#Bg">
                <Setter Property="RenderTransform" Value="scale(0.975)" />
            </Style>
        </Styles>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Bg"
                        Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmall}"
                        BorderThickness="0"
                        RenderTransform="scale(1)"
                        RenderTransformOrigin="50%,50%">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.40,0,0.20,1" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="0.40,0,0.20,1" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="0.40,0,0.20,1" />
                        </Transitions>
                    </Border.Transitions>

                    <TextBlock x:Name="Text"
                               Foreground="{DynamicResource DefaultTextBrush}"
                               Text="{TemplateBinding Title}"
                               FontSize="13"
                               FontFeatures="tnum"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
