<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="using:ShiJian.Client.Controls.Button"
                    xmlns:base="using:ShiJian.Client.Controls.Base"
                    xmlns:input="using:ShiJian.Client.Controls.Input"
                    xmlns:controls="using:ShiJian.Client.Controls.Window">

    <x:Double x:Key="WindowTitleBarHeight">36</x:Double>

    <ControlTheme x:Key="{x:Type controls:DefaultWindow}"
                  TargetType="controls:DefaultWindow">
        <Setter Property="Foreground" Value="{DynamicResource StandardTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
        <Setter Property="UseLayoutRounding" Value="True" />

        <Styles>
            <Style Selector="controls|DefaultWindow[WindowState=Maximized] /template/ Border#WindowBorder">
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BoxShadow" Value="none" />
            </Style>
            <Style Selector="controls|DefaultWindow[WindowState=Maximized] /template/ Border#ContentBorder">
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style Selector="controls|DefaultWindow[WindowState=Maximized] /template/ Panel#OuterResizeFrame">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="controls|DefaultWindow[WindowState=FullScreen] /template/ Panel#OuterResizeFrame">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="controls|DefaultWindow[UseCustomWindowChrome=False] /template/ Border#WindowBorder">
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BoxShadow" Value="none" />
            </Style>
            <Style Selector="controls|DefaultWindow[UseCustomWindowChrome=False] /template/ Border#ContentBorder">
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style Selector="controls|DefaultWindow[UseCustomWindowChrome=False] /template/ Panel#OuterResizeFrame">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="controls|DefaultWindow">
                <Style Selector="^ /template/ button|IconButton#BackBtn">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.09" />
                        </Transitions>
                    </Setter>
                </Style>

                <Style Selector="^[IsCanBack=True] /template/ button|IconButton#BackBtn">
                    <Setter Property="Width" Value="30" />
                </Style>

                <Style Selector="^[ToastType=Success]">
                    <Style Selector="^ /template/ Border#ToastBorder">
                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                    </Style>

                    <Style Selector="^ /template/ base|Icon#ToastIcon">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>

                    <Style Selector="^ /template/ TextBlock#ToastText">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>
                </Style>


                <Style Selector="^[ToastType=Error]">
                    <Style Selector="^ /template/ Border#ToastBorder">
                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                    </Style>

                    <Style Selector="^ /template/ base|Icon#ToastIcon">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>

                    <Style Selector="^ /template/ TextBlock#ToastText">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>
                </Style>
            </Style>
        </Styles>
        <Setter Property="Template">
            <ControlTemplate>
              <Grid>
                <Border x:Name="WindowBorder"
                        CornerRadius="{StaticResource RadiusLarge}"
                        BoxShadow="{DynamicResource Elevation3}"
                        ClipToBounds="False"
                        Margin="16">
                    <Border x:Name="ContentBorder"
                        CornerRadius="{StaticResource RadiusLarge}"
                        ClipToBounds="True"
                        Background="{DynamicResource Surface1Brush}">
                        <Grid>
                            <Grid x:Name="WindowContent">
                            <Grid
                                x:Name="TitleBar"
                                Panel.ZIndex="999"
                                Height="{DynamicResource WindowTitleBarHeight}"
                                VerticalAlignment="Top"
                                IsVisible="True"
                                Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Panel.ZIndex="3">
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <button:IconButton Width="0"
                                                           Height="28"
                                                           CornerRadius="{StaticResource RadiusSmall}"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{DynamicResource Back}"
                                                           FontSize="12"
                                                           x:Name="BackBtn"
                                                           Command="{x:Static controls:DefaultWindow.BackCommand}"
                                                           Icon="Back" />

                                        <Panel VerticalAlignment="Center">
                                            <Image Source="{TemplateBinding IconSource}" VerticalAlignment="Center"
                                                   Stretch="Uniform" Width="18" />
                                            <Border x:Name="StatusDot"
                                                    Width="8" Height="8"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource SubTextBrush}"
                                                    BorderBrush="{DynamicResource Surface1Brush}"
                                                    BorderThickness="1.5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,-2,-2" />
                                        </Panel>
                                        <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Title}"
                                                   IsEnabled="{TemplateBinding IsActive}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" Margin="10,0,0,0" />
                                    </StackPanel>


                                </Grid>
                                <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Panel.ZIndex="3">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <button:IconButton
                                            x:Name="PluginUiButton"
                                            ToolTip.Tip="{DynamicResource PluginsOpenInBrowser}"
                                            Width="30"
                                            Height="28"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            PathStrokeThickness="{DynamicResource TitleBarIconStroke}"
                                            PathData="M1.379,4.777 A1.257,1.226 0 0 1 2.636,3.551 H5.486 A2.179,2.125 0 0 1 9.844,3.551 H12.693 A1.257,1.226 0 0 1 13.95,4.777 V6.738 A2.179,2.125 0 0 1 13.95,10.988 V12.95 A1.257,1.226 0 0 1 12.693,14.176 H2.636 A1.257,1.226 0 0 1 1.379,12.95 V10.743 A1.928,1.88 0 0 0 1.379,6.984 V4.777 Z"
                                            Command="{TemplateBinding TitleBarCommand}"
                                            IsVisible="{TemplateBinding TitleBarCommandVisible}"
                                            HandlesPointerPressed="True" />
                                        <Border Width="1" Height="14" Margin="4,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource DividerSubtleBrush}" />

                                        <button:IconButton
                                            x:Name="MinimizeButton"
                                            ToolTip.Tip="{DynamicResource Minimization}"
                                            Width="34"
                                            Height="28"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            FontSize="10"
                                            Icon="ChromeMinimize"
                                            Command="{x:Static controls:DefaultWindow.MinimizeWindowCommand}"
                                            HandlesPointerPressed="True"
                                            IsVisible="True" />
                                        <button:IconButton
                                            x:Name="MaximizeButton"
                                            ToolTip.Tip="{DynamicResource Maximize}"
                                            Width="34"
                                            Height="28"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            FontSize="10"
                                            Icon="ChromeMaximize"
                                            Command="{x:Static controls:DefaultWindow.MaximizeWindowCommand}"
                                            HandlesPointerPressed="True"
                                            IsVisible="{TemplateBinding MaximizeVisible}" />
                                        <button:IconButton
                                            x:Name="RestoreButton"
                                            ToolTip.Tip="{DynamicResource Restore}"
                                            Width="34"
                                            Height="28"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            FontSize="10"
                                            Icon="ChromeRestore"
                                            Command="{x:Static controls:DefaultWindow.RestoreWindowCommand}"
                                            HandlesPointerPressed="True"
                                            IsVisible="{TemplateBinding RestoreVisible}" />
                                        <button:IconButton
                                            x:Name="CloseButton"
                                            Classes="window-close"
                                            ToolTip.Tip="{DynamicResource Close}"
                                            Width="34"
                                            Height="28"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            FontSize="10"
                                            Icon="ChromeClose"
                                            Command="{x:Static controls:DefaultWindow.CloseWindowCommand}"
                                            HandlesPointerPressed="True"
                                            IsVisible="True" />

                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 必须叫 PART_VisualLayerManager：TopLevel 按这个名字查找，找到才会创建
                                 OverlayLayer 写成别的名字会静默失败，OverlayPopups 模式下弹层直接抛异常 -->
                            <VisualLayerManager Name="PART_VisualLayerManager" Grid.Row="1">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </VisualLayerManager>

                            <Border
                                Padding="16,10"
                                Margin="0,12,0,0"
                                CornerRadius="{StaticResource RadiusMedium}"
                                MinWidth="160"
                                MaxWidth="380"
                                x:Name="ToastBorder"
                                IsVisible="False"
                                Opacity="0"
                                Cursor="Hand"
                                BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource PopupBackgroundBrush}"
                                BoxShadow="{DynamicResource Elevation2}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                ZIndex="1005">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="-44" />
                                </Border.RenderTransform>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <base:Icon IconType="{TemplateBinding ToastIcon}"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               x:Name="ToastIcon" />
                                    <TextBlock x:Name="ToastText" Grid.Column="1"
                                               Text="{TemplateBinding ToastContent}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               TextWrapping="WrapWithOverflow" />
                                </Grid>
                            </Border>

                            <Grid ZIndex="999" x:Name="ToastGrid" IsVisible="False">

                                <Border
                                    Padding="24"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Width="380"
                                    x:Name="DialogBorder"
                                    Background="{DynamicResource PopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource PopupBorderBrush}"
                                    BorderThickness="1"
                                    BoxShadow="{DynamicResource Elevation3}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    RenderTransform="translateY(8px)"
                                    ZIndex="1000">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{TemplateBinding DialogTitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StandardTextBrush}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{TemplateBinding DialogMessage}"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Margin="0,20,0,0">
                                            <button:Button x:Name="CancelBtn"
                                                           Classes="ghost"
                                                           MinWidth="88"
                                                           Content="{DynamicResource Cancel}" />
                                            <button:Button x:Name="ConfirmBtn"
                                                           Classes="primary"
                                                           MinWidth="88"
                                                           Margin="10,0,0,0"
                                                           Content="{DynamicResource Confirm}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border
                                    Padding="24"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Width="400"
                                    x:Name="ActionDialogBorder"
                                    Background="{DynamicResource PopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource PopupBorderBrush}"
                                    BorderThickness="1"
                                    BoxShadow="{DynamicResource Elevation3}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    RenderTransform="translateY(8px)"
                                    ZIndex="1000">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{TemplateBinding DialogTitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StandardTextBrush}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{TemplateBinding DialogMessage}"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Row="2" x:Name="ActionDialogButtonsPanel"
                                                    Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Margin="0,20,0,0" />
                                    </Grid>
                                </Border>

                                <Border
                                    Padding="24"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Width="400"
                                    x:Name="InputModalBorder"
                                    Background="{DynamicResource PopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource PopupBorderBrush}"
                                    BorderThickness="1"
                                    BoxShadow="{DynamicResource Elevation3}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    RenderTransform="translateY(8px)"
                                    ZIndex="1000">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{TemplateBinding DialogTitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StandardTextBrush}"
                                                   Margin="0,0,0,8" />
                                        <Border Grid.Row="1" Margin="0,4,0,0">
                                            <input:InputBox x:Name="InputModalInputBox"
                                                            Placeholder="{TemplateBinding DialogMessage}" />
                                        </Border>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Margin="0,20,0,0">
                                            <button:Button x:Name="InputModalCancelBtn"
                                                           Classes="ghost"
                                                           MinWidth="88"
                                                           Content="{DynamicResource Cancel}" />
                                            <button:Button x:Name="InputModalConfirmBtn"
                                                           Classes="primary"
                                                           MinWidth="88"
                                                           Margin="10,0,0,0"
                                                           Content="{DynamicResource Confirm}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="Masklayer" Background="{DynamicResource ScrimBrush}" Opacity="0">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                            </Grid>

                             <Panel ZIndex="10000" IsHitTestVisible="True">
                                 <Border Width="8" HorizontalAlignment="Left"  VerticalAlignment="Stretch"
                                         Background="Transparent"
                                         WindowDecorationProperties.ElementRole="ResizeW"/>
                                 <Border Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                         Background="Transparent"
                                         WindowDecorationProperties.ElementRole="ResizeE"/>
                                <Border Height="1" VerticalAlignment="Top"    HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        WindowDecorationProperties.ElementRole="ResizeN"/>
                                <Border Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        WindowDecorationProperties.ElementRole="ResizeS"/>

                    <Border Width="12" Height="1" HorizontalAlignment="Left"  VerticalAlignment="Top"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeNW"/>
                    <Border Width="12" Height="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeNE"/>
                    <Border Width="12" Height="8" HorizontalAlignment="Left"  VerticalAlignment="Bottom"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeSW"/>
                    <Border Width="12" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeSE"/>
                </Panel>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- 外层缩放热区：WindowBorder 为了画阴影留了 16 的透明外边距，
                     用户以为最外侧就是窗口边缘，拖那里却是死区（WM_NCHITTEST 返回 HTCLIENT）。
                     这一层把窗口矩形最外层 16 也铺成缩放热区，配合模板内原有的 8 内边距热区，
                     两条带子连起来才是连续的拖拽区。最大化/系统标题栏时隐藏。 -->
                <!-- 注意：这里不能给 Panel 设 Background，否则整块窗口都会变成可命中区域，
                     把内容区的点击全部吞掉。让子 Border 各自覆盖最外圈 16 就够。 -->
                <Panel x:Name="OuterResizeFrame" ZIndex="10001" IsHitTestVisible="True">
                    <Border Height="16" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeN" />
                    <Border Height="16" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeS" />
                    <Border Width="16" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeW" />
                    <Border Width="16" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeE" />
                    <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeNW" />
                    <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeNE" />
                    <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeSW" />
                    <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="Transparent"
                            WindowDecorationProperties.ElementRole="ResizeSE" />
                </Panel>
              </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
