<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="using:ShiJian.Client.Controls.Button"
                    xmlns:base="using:ShiJian.Client.Controls.Base"
                    xmlns:input="using:ShiJian.Client.Controls.Input"
                    xmlns:controls="using:ShiJian.Client.Controls.Window">

    <x:Double x:Key="MacOSWindowTitleBarHeight">36</x:Double>

    <ControlTheme x:Key="{x:Type controls:MacOSWindow}"
                  TargetType="controls:MacOSWindow">
        <Setter Property="Foreground" Value="{DynamicResource StandardTextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />

        <Styles>
            <Style Selector="controls|MacOSWindow">
                <Style Selector="^ /template/ button|IconButton#BackBtn">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.09" Easing="0.40,0,0.20,1" />
                        </Transitions>
                    </Setter>
                </Style>

                <Style Selector="^[IsCanBack=True] /template/ button|IconButton#BackBtn">
                    <Setter Property="Width" Value="30" />
                </Style>

                <Style Selector="^ /template/ button|IconButton#PluginUiButton">
                    <Setter Property="Opacity" Value="0.6" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="0.40,0,0.20,1" />
                        </Transitions>
                    </Setter>
                </Style>

                <Style Selector="^ /template/ button|IconButton#PluginUiButton:pointerover">
                    <Setter Property="Opacity" Value="1" />
                </Style>

                <Style Selector="^ /template/ button|IconButton#PluginUiButton:pressed">
                    <Setter Property="Opacity" Value="1" />
                </Style>

                <Style Selector="^[ToastType=Success]">
                    <Style Selector="^ /template/ Border#ToastBorder">
                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                    </Style>
                    <Style Selector="^ /template/ base|Icon#ToastIcon">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>
                    <Style Selector="^ /template/ TextBlock#ToastText">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>
                </Style>

                <Style Selector="^[ToastType=Error]">
                    <Style Selector="^ /template/ Border#ToastBorder">
                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                    </Style>
                    <Style Selector="^ /template/ base|Icon#ToastIcon">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>
                    <Style Selector="^ /template/ TextBlock#ToastText">
                        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
                    </Style>
                </Style>
            </Style>
        </Styles>

        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="ContentBorder"
                        CornerRadius="0"
                        BorderThickness="0"
                        Background="{DynamicResource Surface1Brush}">
                    <Grid x:Name="WindowContent">
                        <Grid
                            x:Name="TitleBar"
                            Panel.ZIndex="999"
                            Height="{DynamicResource MacOSWindowTitleBarHeight}"
                            VerticalAlignment="Top"
                            Background="Transparent">
                            <Grid Panel.ZIndex="3"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="80,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <button:IconButton Width="0"
                                                       Height="28"
                                                       CornerRadius="{StaticResource RadiusSmall}"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{DynamicResource Back}"
                                                       FontSize="12"
                                                       x:Name="BackBtn"
                                                       Command="{x:Static controls:MacOSWindow.BackCommand}"
                                                       Icon="Back" />

                                    <Panel VerticalAlignment="Center">
                                        <Image Source="{TemplateBinding IconSource}" VerticalAlignment="Center"
                                               Stretch="Uniform" Width="18" />
                                        <Border x:Name="StatusDot"
                                                Width="8" Height="8"
                                                CornerRadius="4"
                                                Background="{DynamicResource SubTextBrush}"
                                                BorderBrush="{DynamicResource Surface1Brush}"
                                                BorderThickness="1.5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,-2,-2" />
                                    </Panel>
                                    <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Title}"
                                               IsEnabled="{TemplateBinding IsActive}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SubTextBrush}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 低频入口：默认只留低对比度图标，悬停才浮出底色，尽量不抢标题栏视线 -->
                            <Grid Panel.ZIndex="3"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,12,0">
                                <button:IconButton x:Name="PluginUiButton"
                                                   Width="28"
                                                   Height="28"
                                                   CornerRadius="{StaticResource RadiusSmall}"
                                                   ToolTip.Tip="{DynamicResource PluginsOpenInBrowser}"
                                                   PathStrokeThickness="{DynamicResource TitleBarIconStroke}"
                                                   PathData="M1.379,4.777 A1.257,1.226 0 0 1 2.636,3.551 H5.486 A2.179,2.125 0 0 1 9.844,3.551 H12.693 A1.257,1.226 0 0 1 13.95,4.777 V6.738 A2.179,2.125 0 0 1 13.95,10.988 V12.95 A1.257,1.226 0 0 1 12.693,14.176 H2.636 A1.257,1.226 0 0 1 1.379,12.95 V10.743 A1.928,1.88 0 0 0 1.379,6.984 V4.777 Z"
                                                   Command="{TemplateBinding TitleBarCommand}"
                                                   IsVisible="{TemplateBinding TitleBarCommandVisible}"
                                                   HandlesPointerPressed="True" />
                            </Grid>

                        </Grid>

                        <!-- 必须叫 PART_VisualLayerManager：TopLevel 按这个名字查找，找到才会创建
                             OverlayLayer 写成别的名字会静默失败，OverlayPopups 模式下弹层直接抛异常 -->
                        <VisualLayerManager Name="PART_VisualLayerManager">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </VisualLayerManager>

                        <Border
                            Padding="16,10"
                            Margin="0,12,0,0"
                            CornerRadius="{StaticResource RadiusMedium}"
                            MinWidth="160"
                            MaxWidth="380"
                            x:Name="ToastBorder"
                            IsVisible="False"
                            Opacity="0"
                            Cursor="Hand"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BoxShadow="{DynamicResource Elevation2}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            ZIndex="1005">
                            <Border.RenderTransform>
                                <TranslateTransform Y="-44" />
                            </Border.RenderTransform>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <base:Icon IconType="{TemplateBinding ToastIcon}"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           x:Name="ToastIcon" />
                                <TextBlock x:Name="ToastText" Grid.Column="1"
                                           Text="{TemplateBinding ToastContent}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           TextWrapping="WrapWithOverflow" />
                            </Grid>
                        </Border>

                        <Grid ZIndex="999" x:Name="ToastGrid" IsVisible="False">

                        <Border
                            Padding="24"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Width="380"
                            x:Name="DialogBorder"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource Elevation3}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0"
                            ZIndex="1000">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding DialogTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StandardTextBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1"
                                           Text="{TemplateBinding DialogMessage}"
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,20,0,0">
                                    <button:Button x:Name="CancelBtn"
                                                   Classes="ghost"
                                                   MinWidth="88"
                                                   Content="{DynamicResource Cancel}" />
                                    <button:Button x:Name="ConfirmBtn"
                                                   Classes="primary"
                                                   MinWidth="88"
                                                   Margin="10,0,0,0"
                                                   Content="{DynamicResource Confirm}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Width="400"
                            x:Name="ActionDialogBorder"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource Elevation3}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0"
                            ZIndex="1000">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding DialogTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StandardTextBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1"
                                           Text="{TemplateBinding DialogMessage}"
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Row="2" x:Name="ActionDialogButtonsPanel"
                                            Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,20,0,0" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Width="400"
                            x:Name="InputModalBorder"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource Elevation3}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0"
                            ZIndex="1000">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding DialogTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StandardTextBrush}"
                                           Margin="0,0,0,8" />
                                <Border Grid.Row="1" Margin="0,4,0,0">
                                    <input:InputBox x:Name="InputModalInputBox"
                                                    Placeholder="{TemplateBinding DialogMessage}" />
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,20,0,0">
                                    <button:Button x:Name="InputModalCancelBtn"
                                                   Classes="ghost"
                                                   MinWidth="88"
                                                   Content="{DynamicResource Cancel}" />
                                    <button:Button x:Name="InputModalConfirmBtn"
                                                   Classes="primary"
                                                   MinWidth="88"
                                                   Margin="10,0,0,0"
                                                   Content="{DynamicResource Confirm}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="Masklayer" Background="{DynamicResource ScrimBrush}" Opacity="0" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
