<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ShiJian.Client.Controls.Base">


    <ControlTheme x:Key="{x:Type controls:Img}"
                  TargetType="controls:Img">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Radius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        CornerRadius="{TemplateBinding Radius}"
                        Background="{Binding IconPlateBackground, RelativeSource={RelativeSource TemplatedParent}}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid Margin="{Binding IconPlatePadding, RelativeSource={RelativeSource TemplatedParent}}">
                            <controls:SafeImage Stretch="Uniform"
                                                IsVisible="{Binding !HasSvg, RelativeSource={RelativeSource TemplatedParent}}"
                                                Source="{Binding Resource,RelativeSource={RelativeSource TemplatedParent}}" />
                            <Viewbox Stretch="Uniform"
                                     IsVisible="{Binding HasSvg, RelativeSource={RelativeSource TemplatedParent}}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding SvgGeometry, RelativeSource={RelativeSource TemplatedParent}}"
                                          Fill="{TemplateBinding Foreground}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <!-- 图标解码失败时降级成“首字母色块”，比默认图标更好认 -->
                        <Border Background="{Binding FallbackBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                IsVisible="{Binding IsFallbackVisible, RelativeSource={RelativeSource TemplatedParent}}">
                            <Viewbox Margin="2" Stretch="Uniform">
                                <TextBlock Text="{Binding FallbackGlyph, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="16" />
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>