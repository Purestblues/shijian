<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:button="using:ShiJian.Client.Controls.Button"
                    xmlns:controls="using:ShiJian.Client.Controls.Base"
                    xmlns:behaviors="using:ShiJian.Client.Behaviors">


    <ControlTheme x:Key="{x:Type controls:IconSelect}" TargetType="controls:IconSelect">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource SelectRingBrush}" CornerRadius="{StaticResource RadiusMedium}" BorderThickness="2"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}" Cursor="Hand">

                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="PointerPressed">
                            <InvokeCommandAction
                                Command="{Binding ShowSelectCommand,RelativeSource={RelativeSource TemplatedParent}}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>

                    <Grid>
                        <controls:Img HorizontalAlignment="Center"
                                      VerticalAlignment="Center" URL="{TemplateBinding URL}" Width="30" Height="30" DecodeWidth="30" />

                        <Popup
                            x:Name="Popup"
                            Placement="Bottom"
                            IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsOpen, Mode=TwoWay}">
                            <Interaction.Behaviors>
                                <behaviors:PopupScrollDismissBehavior />
                            </Interaction.Behaviors>

                            <Border
                                x:Name="SelectContainer"
                                CornerRadius="{StaticResource RadiusMedium}"
                                BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="1"
                                BoxShadow="{DynamicResource Elevation2}"
                                Background="{DynamicResource PopupBackgroundBrush}"
                                TextElement.Foreground="{DynamicResource DefaultTextBrush}"
                                Padding="10" Width="275" MaxHeight="300" Margin="8">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{DynamicResource SelectIcon}" VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource DefaultTextBrush}" />

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ListBox
                                            ItemsSource="{TemplateBinding Icons}"
                                            SelectedItem="{TemplateBinding URL,Mode=TwoWay}"
                                            Margin="0,10,0,0"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">


                                            <ListBox.Styles>
                                                <Style Selector="ListBox">
                                                    <Setter Property="Template">
                                                        <ControlTemplate>
                                                            <Border>
                                                                <ItemsPresenter
                                                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter>
                                                </Style>

                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Template">
                                                        <ControlTemplate>
                                                            <Border BorderBrush="Transparent"
                                                                    BorderThickness="2" x:Name="Border"
                                                                    Background="Transparent" Margin="0,0,0,0"
                                                                    Padding="0" Width="35" Height="35" CornerRadius="5">

                                                                <ContentPresenter x:Name="Icon"
                                                                    VerticalAlignment="Center"
                                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                    Content="{TemplateBinding Content}"
                                                                    HorizontalAlignment="Center">

                                                                    <ContentPresenter.Transitions>
                                                                        <Transitions>
                                                                            <TransformOperationsTransition
                                                                                Property="RenderTransform"
                                                                                Duration="0:0:0.15"
                                                                        Easing="0.40,0,0.20,1" />
                                                                        </Transitions>
                                                                    </ContentPresenter.Transitions>
                                                                </ContentPresenter>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter>

                                                    <Style Selector="^:pointerover">
                                                        <Style Selector="^ /template/ Border#Border">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource HoverBackgroundBrush}" />

                                                        </Style>
                                                        <Style Selector="^ /template/ Border ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </Style>
                                                    </Style>

                                                    <Style Selector="^ /template/ Border ContentPresenter">
                                                        <Setter Property="RenderTransform" Value="scale(0.8)" />
                                                    </Style>

                                                    <Style Selector="^:selected">
                                                        <Style Selector="^ /template/ Border#Border">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource ThemeBrush}" />
                                                        </Style>

                                                        <Style Selector="^ /template/ Border ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="TextElement.Foreground" Value="White" />
                                                            <Setter Property="RenderTransform" Value="scale(1)" />
                                                        </Style>
                                                    </Style>
                                                </Style>
                                            </ListBox.Styles>

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Border>
                                                            <controls:Img URL="{Binding}" Width="25" Height="25" NoCache="True" />
                                                        </Border>
                                                    </WrapPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>

                                    <button:Button Grid.Row="2" Icon="Photo" HorizontalAlignment="Right"
                                                   Command="{Binding FileSelectCommand,RelativeSource={RelativeSource TemplatedParent}}"
                                                   Content="{DynamicResource CustomPicture}" Width="120" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>