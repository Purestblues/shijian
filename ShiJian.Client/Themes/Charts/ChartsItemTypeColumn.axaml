<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

                    xmlns:controls="using:ShiJian.Client.Controls.Charts">

    <ControlTheme x:Key="{x:Type controls:ChartItemTypeColumn}"
                  TargetType="controls:ChartItemTypeColumn">
        <Styles>
            <Style Selector="controls|ChartItemTypeColumn /template/ Border#ValueContainer">
                <Setter Property="Transitions">
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.40,0,0.20,1" />
                </Setter>
            </Style>

            <Style Selector="controls|ChartItemTypeColumn:pointerover /template/ Border#ValueContainer">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
            </Style>
        </Styles>

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="Normal" Background="{TemplateBinding Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ValueContainer" Background="Transparent" CornerRadius="4">
                        <Rectangle
                            x:Name="ValueBlockObj"
                            RadiusX="4"
                            RadiusY="4"
                            Fill="{DynamicResource SubTextBrush}"
                            Width="{Binding ElementName=ValueContainer,Path=Bounds.Width}"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1" FontSize="12"
                               FontFeatures="tnum"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Text="{TemplateBinding ColumnName}"
                               Foreground="{DynamicResource SubTextBrush}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>