<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:ShiJian.Client.Controls.Base"
                    xmlns:models="using:ShiJian.Client.Controls.Charts.Model"
                    xmlns:controls="using:ShiJian.Client.Controls.Charts">

    <ControlTheme x:Key="{x:Type controls:ColumnChart}" TargetType="controls:ColumnChart">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Styles>
            <Style Selector="controls|ColumnChart[IsShowCategory=True] /template/ Border#ChartBorder">
                <Setter Property="Height" Value="260" />
                <Setter Property="MinHeight" Value="260" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style Selector="controls|ColumnChart[IsShowCategory=True] /template/ Grid#CategoryLegend">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="controls|ColumnChart[IsShowTotal=False] /template/ StackPanel#ColumnTitle">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Styles>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="ColumnTitle">
                        <TextBlock Text="{DynamicResource Aggregate}"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <TextBlock Margin="0,5,0,0" Text="{TemplateBinding Total}" FontSize="20"
                                   Foreground="{DynamicResource DefaultTextBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Popup IsOpen="{TemplateBinding IsShowValuesPopup}"
                               Placement="Top"
                               HorizontalOffset="{TemplateBinding ValuesPopupHorizontalOffset}"
                               PlacementTarget="{TemplateBinding ValuesPopupPlacementTarget}">
                            <Border IsHitTestVisible="False"
                                Background="{DynamicResource PopupBackgroundBrush}"
                                BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                BoxShadow="{DynamicResource Elevation2}"
                                Padding="12,10"
                                Margin="10">
                                <ListBox ItemsSource="{TemplateBinding ColumnValuesInfoList}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBox">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <Border>
                                                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <Border BorderBrush="Transparent" BorderThickness="0"
                                                            x:Name="Border" Margin="0,2">
                                                        <ContentPresenter
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            Content="{TemplateBinding Content}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChartColumnInfoModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <base:View Grid.Column="0" Condition="not null" Value="{Binding Color}">
                                                    <Border Margin="0,0,8,0" Width="8"
                                                            CornerRadius="2" Height="8"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Color,Converter={StaticResource HextoColorConverter}}" />
                                                </base:View>
                                                <TextBlock Grid.Column="1"
                                                           Foreground="{DynamicResource DefaultTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Name}" FontSize="12" />
                                                <TextBlock Grid.Column="2" FontSize="12" Margin="12,0,0,0"
                                                           FontWeight="SemiBold"
                                                           FontFeatures="tnum"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource DefaultTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>

                        <Border x:Name="ChartBorder" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ChartColBorderBrush}">
                            <controls:ColumnChartCanvas x:Name="TypeColumnCanvas" />
                        </Border>
                        <base:EmptyData x:Name="EmptyDataView" IsVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- category legend -->
                    <Grid Grid.Row="2" IsHitTestVisible="False" Focusable="False"
                          Margin="0,8,0,0" x:Name="CategoryLegend" IsVisible="False">
                        <ListBox ItemsSource="{TemplateBinding ColumnInfoList}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBox">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border>
                                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border BorderBrush="Transparent" BorderThickness="2"
                                                    Background="Transparent" Margin="0" CornerRadius="10"
                                                    x:Name="Border">
                                                <ContentPresenter
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Content="{TemplateBinding Content}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ChartColumnInfoModel">
                                    <WrapPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                                            <Rectangle Width="12" RadiusX="4" RadiusY="4" Height="12"
                                                       Fill="{Binding Color,Converter={StaticResource HextoColorConverter}}" />
                                            <base:View Condition="not empty" Value="{Binding Icon}">
                                                <base:Img Margin="5,0,0,0" Width="16" Height="16"
                                                          DecodeWidth="16" URL="{Binding Icon}"
                                                          FallbackText="{Binding Name}" />
                                            </base:View>
                                            <TextBlock Margin="5,0,0,0"
                                                       Foreground="{DynamicResource DefaultTextBrush}"
                                                       VerticalAlignment="Center" Text="{Binding Name}"
                                                       MaxWidth="100"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Margin="5,0,0,0"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       VerticalAlignment="Center" Text="{Binding Text}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
