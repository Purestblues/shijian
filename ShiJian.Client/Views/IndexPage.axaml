<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             Foreground="{DynamicResource StandardTextBrush}"
             Background="Transparent"
             xmlns:vm="using:ShiJian.Client.ViewModels"
             x:DataType="vm:IndexPageViewModel"
             xmlns:Charts="using:ShiJian.Client.Controls.Charts"
             xmlns:models="using:ShiJian.Client.Controls.Charts.Model"
             xmlns:base="using:ShiJian.Client.Controls.Base"
             xmlns:select="using:ShiJian.Client.Controls.Select"
             xmlns:toggle="using:ShiJian.Client.Controls.Toggle"
             xmlns:conv="using:ShiJian.Client.Controls.Converters"
             xmlns:platform="clr-namespace:ShiJian.Client.Platform"
             x:Class="ShiJian.Client.Views.IndexPage">

    <!--https://github.com/AvaloniaUI/Avalonia/issues/2441-->
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem
                Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <UserControl.Resources>
        <conv:HextoColorConverter x:Key="HexToColor" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!--「网站并入浏览器」打开时，应用列吃掉网站列的位置-->
        <Style Selector="Border.frequentAppColumn.fullWidth">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <!--Avalonia 的类型选择器不匹配派生类，CountUpText 需要单独声明；卡片本身走全局 UiKit-->
        <Style Selector="base|CountUpText.statValue">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXxl}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <!-- 滚动由 PageContainer 模板里的 ScrollViewer 提供，这里不要再套一层 -->
    <StackPanel x:Name="PageRoot" Margin="24,10,24,64">

            <!-- ═══ 头部：标题 + 周期切换 ═══ -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0" Text="{DynamicResource SideOverview}"
                           FontSize="18"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <select:TabSwitch IsShowIcon="False"
                                      VerticalAlignment="Center"
                                      SelectedItem="{Binding WebMergeOption,Mode=TwoWay}"
                                      Options="{Binding WebMergeOptions}" />
                    <select:TabSwitch IsShowIcon="False"
                                      SelectedItem="{Binding SelectedPeriod,Mode=TwoWay}"
                                      Options="{Binding PeriodOptions}" />
                </StackPanel>
            </Grid>

            <!-- 实体接口不可用：说明原因并给重试，而不是显示成「今天 0 秒」 -->
            <Border IsVisible="{Binding HasEntityError}"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource ThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="14,10" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding EntityErrorText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Margin="12,0,0,0" Padding="10,0" Height="28"
                                Content="{DynamicResource Retry}"
                                Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <!-- 自定义范围：选「自定义」时展开（高度由 ExpandMotion 动画，代码在后面驱动） -->
            <Border x:Name="CustomRangeHost" IsVisible="False" ClipToBounds="False" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                <select:DateSelect Date="{Binding CustomStart,Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource To}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                <select:DateSelect Date="{Binding CustomEnd,Mode=TwoWay}" VerticalAlignment="Center" />
            </StackPanel>
            </Border>

            <!-- ═══ 总览卡片 ═══ -->
            <Grid x:Name="StatCardsPanel" ColumnDefinitions="*,10,*,10,*,10,*">

                <!-- 总使用时长 -->
                <Border Grid.Column="0" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Stopwatch" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource CategoryTotalUsage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Duration" Value="{Binding TotalTime}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Value="{Binding TotalTime}" LastValue="{Binding LastTotalTime}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 应用量 -->
                <Border Grid.Column="2" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Apps" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource Usage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Number" Value="{Binding AppCount}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Type="Number" Value="{Binding AppCount}" LastValue="{Binding LastAppCount}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 站点 -->
                <Border x:Name="SiteStatCard" Grid.Column="4" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Website" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource Site}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Number" Value="{Binding WebSiteCount}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Type="Number" Value="{Binding WebSiteCount}" LastValue="{Binding LastWebSiteCount}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 网页 -->
                <Border x:Name="WebPageStatCard" Grid.Column="6" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="WebSearch" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource Webpage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <base:CountUpText Classes="statValue" Kind="Number" Value="{Binding WebPageCount}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                            <TextBlock Classes="cardCaption" Text="{Binding CompareCaption}"
                                       VerticalAlignment="Center" />
                            <base:DiffValue Type="Number" Value="{Binding WebPageCount}" LastValue="{Binding LastWebPageCount}"
                                            PositiveBrush="{DynamicResource ThemeBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ 图表区：时段分布 + 分类占比 ═══ -->
            <Grid ColumnDefinitions="5*,12,4*" Margin="0,16,0,0" MinHeight="228">

                <Border Grid.Column="0" Classes="card" Padding="16,12">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{DynamicResource CategoryHourly}" FontSize="13" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Classes="cardCaption" Text="{DynamicResource Total}" VerticalAlignment="Center" />
                                <TextBlock Classes="cardCaption" Text="{Binding HourTotalText}"
                                           Foreground="{DynamicResource DefaultTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <toggle:Toggle Grid.Column="2"
                                           OnText="{Binding CompareCaption}"
                                           OffText="{Binding CompareCaption}"
                                           IsChecked="{Binding IsCompareEnabled,Mode=TwoWay}"
                                           IsVisible="{Binding IsCompareSupported}" />
                        </Grid>

                        <Charts:StackedBarChart Grid.Row="1" Margin="0,10,0,0"
                                                IsLoading="{Binding IsLoading}"
                                                Series="{Binding HourSeries}"
                                                Labels="{Binding HourLabels}"
                                                CompareValues="{Binding CompareValues}"
                                                CompareBrush="{DynamicResource ChartCompareBrush}"
                                                EmptyText="{DynamicResource NoData}"
                                                TextBrush="{DynamicResource SubTextBrush}"
                                                MutedTextBrush="{DynamicResource SubTextBrush}"
                                                AxisBrush="{DynamicResource WindowBorderBrush}"
                                                HoverBrush="{DynamicResource HoverBackgroundBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card" Padding="16,12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="{DynamicResource ClassificationProportion}" FontSize="13" />

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                            <Charts:DonutChart Width="108" Height="108"
                                               Thickness="11"
                                               IsLoading="{Binding IsLoading}"
                                               Series="{Binding CategorySeries}"
                                               CenterText="{Binding CategoryTotalText}"
                                               CenterCaption="{Binding ChartDonutCaption}"
                                               EmptyText="{DynamicResource NoData}"
                                               TextBrush="{DynamicResource DefaultTextBrush}"
                                               MutedTextBrush="{DynamicResource SubTextBrush}"
                                               TrackBrush="{DynamicResource Surface3Brush}" />

                            <ScrollViewer Grid.Column="1" Margin="10,0,0,0"
                                          Padding="0,0,6,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CategorySeries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChartsDataModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,5">
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Color, Converter={StaticResource HexToColor}}" />
                                                <TextBlock Grid.Column="1" Margin="6,0,6,0" FontSize="11"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource DefaultTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="11"
                                                           FontFeatures="tnum"
                                                           Text="{Binding Tag}"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 最为频繁 ═══ -->
            <TextBlock Text="{DynamicResource MostFrequent}" Classes="eyebrow" Margin="0,24,0,12" />

            <Grid ColumnDefinitions="3*,12,2*">
                <!--应用（「网站并入浏览器」打开时占满整行）-->
                <Border Grid.Column="0" Classes="card frequentAppColumn"
                        Classes.fullWidth="{Binding IsWebBrowserMerged}" Padding="8">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Padding="9,4"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Background="{DynamicResource Surface3Brush}"
                                Margin="4,2,0,4">
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource SubTextBrush}">
                                <base:Icon VerticalAlignment="Center" IconType="Apps" FontSize="12" />
                                <TextBlock FontSize="10"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource App}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Charts:ListChart IsLoading="{Binding IsLoading}" IconSize="{x:Static platform:PlatformConstants.SmallListIconSize}"
                                          Margin="0,2,0,0" IsCanScroll="False"
                                          BarBrush="{DynamicResource ThemeBrush}"
                                          Data="{Binding AppFrequentUseData}"
                                          IsShowBadge="True"
                                          BadgeClickCommand="{Binding CategoryClickCommand}"
                                          ClickCommand="{Binding ToDetailCommand}"
                                          MenuType="App" />
                    </StackPanel>
                </Border>

                <!--网页-->
                <Border Grid.Column="2" Classes="card" IsVisible="{Binding IsWebListVisible}" Padding="8">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Padding="9,4"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Background="{DynamicResource ThemeTintBrush}"
                                Margin="4,2,0,4">
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource ThemeBrush}">
                                <base:Icon VerticalAlignment="Center" IconType="Website" FontSize="12" />
                                <TextBlock FontSize="10" VerticalAlignment="Center" Text="{DynamicResource Website}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Charts:ListChart IsLoading="{Binding IsLoading}" IconSize="{x:Static platform:PlatformConstants.SmallListIconSize}"
                                          Margin="0,2,0,0" IsCanScroll="False"
                                          BarBrush="{DynamicResource ThemeBrush}"
                                          Data="{Binding WebFrequentUseData}"
                                          IsShowBadge="True"
                                          BadgeClickCommand="{Binding CategoryClickCommand}"
                                          ClickCommand="{Binding ToDetailCommand}"
                                          MenuType="WebSite" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ 更多 ═══ -->
            <TextBlock Text="{DynamicResource More}" Classes="eyebrow" Margin="0,16,0,0" />

            <Charts:CardChart Data="{Binding MoreData}"
                              MenuType="App"
                              Margin="0,8,0,0"
                              ShowLimit="{Binding MoreNum}"
                              IconSize="{x:Static platform:PlatformConstants.CardChartIconSize}"
                              ClickCommand="{Binding ToDetailCommand}">
                <Charts:CardChart.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
                    </ContextMenu>
                </Charts:CardChart.ContextMenu>
            </Charts:CardChart>

    </StackPanel>
</UserControl>
