<control:TPage xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
               xmlns:Charts="using:ShiJian.Client.Controls.Charts"
               xmlns:select="using:ShiJian.Client.Controls.Select"
               xmlns:base="using:ShiJian.Client.Controls.Base"
               xmlns:Button="using:ShiJian.Client.Controls.Button"
               xmlns:timeline="using:ShiJian.Client.Controls.Timeline"
               xmlns:control="using:ShiJian.Client.Controls"
               xmlns:converters="using:ShiJian.Client.Controls.Converters"
               xmlns:models="using:ShiJian.Client.Models"
               xmlns:chartModels="using:ShiJian.Client.Controls.Charts.Model"
               xmlns:vm="using:ShiJian.Client.ViewModels"
               x:DataType="vm:DataPageViewModel"
               IsFillPage="True"
               x:Class="ShiJian.Client.Views.DataPage">
    <control:TPage.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
        </ContextMenu>
    </control:TPage.ContextMenu>
    <control:TPage.Resources>
        <converters:BoolToThicknessConverter x:Key="PageMarginConverter"
                                             TrueValue="24,24,24,64"
                                             FalseValue="24,0,24,24" />
        <converters:BoolToThicknessConverter x:Key="ContentMarginConverter"
                                             TrueValue="0,13,0,0"
                                             FalseValue="0,0,0,0" />
        <converters:BoolToDoubleConverter x:Key="HeaderMaxHeightConverter"
                                          TrueValue="120"
                                          FalseValue="0" />
        <converters:BoolToDoubleConverter x:Key="BoolToOpacityConverter"
                                          TrueValue="1"
                                          FalseValue="0" />
        <converters:BoolToDoubleConverter x:Key="InverseOpacityConverter"
                                          TrueValue="0"
                                          FalseValue="1" />
        <converters:ShowTypeToContextMenuTypeConverter x:Key="ShowTypeToContextMenuTypeConverter" />
        <converters:HextoColorConverter x:Key="HextoColorConverter" />
        <converters:BoolToGridLengthConverter x:Key="ClockColumnWidth" TrueValue="*" FalseValue="Auto" />
        <converters:BoolToGridLengthConverter x:Key="ListColumnWidth" TrueValue="420" FalseValue="*" />
    </control:TPage.Resources>

    <control:TPage.Styles>
        <!--看板卡片-->
        <Style Selector="Border.insightCard">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        </Style>

        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.habitValue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </control:TPage.Styles>

    <Grid>
        <Grid Margin="{Binding IsHeaderExpanded, Converter={StaticResource PageMarginConverter}}">
            <Grid.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.225">
                        <ThicknessTransition.Easing>
                            <CubicEaseInOut />
                        </ThicknessTransition.Easing>
                    </ThicknessTransition>
                </Transitions>
            </Grid.Transitions>
            <Grid.Styles>
                <Style Selector="select|TabSwitch#ColorModeSwitch select|TabOption">
                    <Setter Property="Padding" Value="10,3" />
                    <Setter Property="FontSize" Value="11" />
                </Style>
            </Grid.Styles>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══ Row 0：标题 · 应用/网站切换 · 日期 · 周期 ═══ -->
            <Border MaxHeight="{Binding IsHeaderExpanded, Converter={StaticResource HeaderMaxHeightConverter}}"
                    Opacity="{Binding IsHeaderExpanded, Converter={StaticResource BoolToOpacityConverter}}"
                    IsHitTestVisible="{Binding IsHeaderExpanded}"
                    ClipToBounds="True">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="MaxHeight" Duration="0:0:0.225">
                            <DoubleTransition.Easing>
                                <CubicEaseInOut />
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.225">
                            <DoubleTransition.Easing>
                                <CubicEaseInOut />
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </Border.Transitions>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                      Margin="0,5,0,16">
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource SideDetails}"
                               FontSize="18"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <!-- 日期选择 -->
                        <Grid VerticalAlignment="Center">
                            <base:View Condition="0" Value="{Binding TabbarSelectedIndex}">
                                <select:DateSelect Date="{Binding DayDate,Mode=TwoWay}" />
                            </base:View>
                            <base:View Condition="1" Value="{Binding TabbarSelectedIndex}">
                                <select:DateSelect Date="{Binding WeekDate,Mode=TwoWay}"
                                                   SelectType="Week" />
                            </base:View>
                            <base:View Condition="2" Value="{Binding TabbarSelectedIndex}">
                                <select:DateSelect Date="{Binding MonthDate,Mode=TwoWay}"
                                                   SelectType="Month" />
                            </base:View>
                            <base:View Condition="3" Value="{Binding TabbarSelectedIndex}">
                                <select:DateSelect Date="{Binding YearDate,Mode=TwoWay}"
                                                   SelectType="Year" />
                            </base:View>
                        </Grid>

                        <!-- 周期切换 -->
                        <select:TabSwitch IsShowIcon="False"
                                          SelectedItem="{Binding SelectedPeriod,Mode=TwoWay}"
                                          Options="{Binding PeriodOptions}" />
                    </StackPanel>

                    <!-- 收起筛选栏 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button:IconButton Width="30" Height="30" FontSize="14"
                                           Icon="ChevronUpMed"
                                           ToolTip.Tip="{DynamicResource CollapseHeader}"
                                           Command="{Binding ToggleHeaderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Row 1：左侧主区（指标卡 / 表盘 / 柱图） + 右侧洞察栏 ═══ -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto"
                  Margin="{Binding IsHeaderExpanded, Converter={StaticResource ContentMarginConverter}}">

                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">

                    <!-- 配色模式 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock FontSize="11"
                                   Text="{DynamicResource ClockHint}"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                        <select:TabSwitch x:Name="ColorModeSwitch"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsShowIcon="False"
                                          SelectedItem="{Binding SelectedColorMode, Mode=TwoWay}"
                                          Options="{Binding ColorModeOptions}" />
                    </Grid>

                    <!-- A：关键指标卡（含实体接口不可用提示） -->
                    <StackPanel Grid.Row="1">
                        <Border IsVisible="{Binding HasEntityError}"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource ThemeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding EntityErrorText}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Margin="12,0,0,0" Padding="10,0" Height="28"
                                        Content="{DynamicResource Retry}"
                                        Command="{Binding RefreshCommand}" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,8,*,8,*,8,*" Margin="0,0,0,12">
                        <Border Grid.Column="0" Classes="statCard">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <base:Icon IconType="Stopwatch" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card1.Caption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="statValue" Text="{Binding CurrentInsight.Card1.Value}" />
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            IsVisible="{Binding CurrentInsight.Card1.HasDiff}">
                                    <base:Icon IconType="ArrowUp8" FontSize="10"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CurrentInsight.Card1.IsUp}" />
                                    <base:Icon IconType="ArrowDown8" FontSize="10"
                                               Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CurrentInsight.Card1.IsDown}" />
                                    <base:Icon IconType="SubtractBold" FontSize="10"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CurrentInsight.Card1.IsFlat}" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card1.DiffText}"
                                               Foreground="{DynamicResource DefaultTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card1.DiffCaption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card1.Sub}"
                                           IsVisible="{Binding CurrentInsight.Card1.HasSub}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="statCard">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <base:Icon IconType="Apps" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card2.Caption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="statValue" Text="{Binding CurrentInsight.Card2.Value}" />
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            IsVisible="{Binding CurrentInsight.Card2.HasDiff}">
                                    <base:Icon IconType="ArrowUp8" FontSize="10"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CurrentInsight.Card2.IsUp}" />
                                    <base:Icon IconType="ArrowDown8" FontSize="10"
                                               Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CurrentInsight.Card2.IsDown}" />
                                    <base:Icon IconType="SubtractBold" FontSize="10"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CurrentInsight.Card2.IsFlat}" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card2.DiffText}"
                                               Foreground="{DynamicResource DefaultTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card2.DiffCaption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card2.Sub}"
                                           IsVisible="{Binding CurrentInsight.Card2.HasSub}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Classes="statCard">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <base:Icon IconType="BulletedList" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card3.Caption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="statValue" Text="{Binding CurrentInsight.Card3.Value}" />
                                <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card3.Sub}"
                                           IsVisible="{Binding CurrentInsight.Card3.HasSub}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Classes="statCard">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <base:Icon IconType="ScreenTime" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card4.Caption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="statValue" Text="{Binding CurrentInsight.Card4.Value}" />
                                <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.Card4.Sub}"
                                           IsVisible="{Binding CurrentInsight.Card4.HasSub}" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 主图：环形时钟 + 图例 / 榜单 -->
                    <TabControl Grid.Row="2"
                                SelectedIndex="{Binding TabbarSelectedIndex}"
                                BorderThickness="0"
                                Margin="0,0,0,12"
                                Padding="0"
                                Background="Transparent">
                        <TabControl.Styles>
                            <Style Selector="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Styles>
                        <TabItem>
                            <!-- 环形时钟 + 图例 -->
                            <Grid ColumnDefinitions="*,Auto">
                                    <timeline:ClockRing HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        MaxWidth="420"
                                                        MaxHeight="420"
                                                        Thickness="30"
                                                        Margin="0,4,14,4"
                                                        IsLoading="{Binding IsLoading}"
                                                        Segments="{Binding DayClock.Segments}"
                                                        TickMode="{Binding DayClock.TickMode}"
                                                        RangeStart="{Binding DayClock.RangeStart}"
                                                        RangeEnd="{Binding DayClock.RangeEnd}"
                                                        UseCategoryColor="{Binding UseCategoryColor}"
                                                        CenterText="{Binding DayClock.CenterText}"
                                                        CenterCaption="{Binding DayClock.CenterCaption}"
                                                        EmptyText="{DynamicResource NoData}"
                                                        TextBrush="{DynamicResource StandardTextBrush}"
                                                        MutedTextBrush="{DynamicResource SubTextBrush}"
                                                        TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                                        ClickCommand="{Binding ToDetailCommand}" />

                                    <Border Grid.Column="1"
                                            Width="230"
                                            Padding="12,10"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMedium}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{DynamicResource ClockLegendTitle}"
                                                       FontSize="11"
                                                       Margin="2,0,0,6"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                            <ScrollViewer MaxHeight="165" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DayClock.Legend}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="2,3"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Command="{Binding $parent[UserControl].((vm:DataPageViewModel)DataContext).ClockLegendClickCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                                <Ellipse Width="9" Height="9"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,8,0"
                                                                         Fill="{Binding Color, Converter={StaticResource HextoColorConverter}}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource StandardTextBrush}" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding DurationText}"
                                                                           FontSize="12"
                                                                           FontFeatures="tnum"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource StandardTextBrush}" />
                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding ShareText}"
                                                                           FontSize="11"
                                                                           FontFeatures="tnum"
                                                                           Width="36"
                                                                           TextAlignment="Right"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SubTextBrush}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <Grid ColumnDefinitions="*,420">
                                <timeline:ClockRing HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="420"
                                                    MaxHeight="420"
                                                    Thickness="30"
                                                    Margin="0,0,14,0"
                                                    IsLoading="{Binding IsLoading}"
                                                    Segments="{Binding WeekClock.Segments}"
                                                    TickMode="{Binding WeekClock.TickMode}"
                                                    RangeStart="{Binding WeekClock.RangeStart}"
                                                    RangeEnd="{Binding WeekClock.RangeEnd}"
                                                    UseCategoryColor="{Binding UseCategoryColor}"
                                                    CenterText="{Binding WeekClock.CenterText}"
                                                    CenterCaption="{Binding WeekClock.CenterCaption}"
                                                    EmptyText="{DynamicResource NoData}"
                                                    TextBrush="{DynamicResource StandardTextBrush}"
                                                    MutedTextBrush="{DynamicResource SubTextBrush}"
                                                    TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                                    ClickCommand="{Binding ToDetailCommand}" />
                                <Charts:ListChart IsLoading="{Binding IsLoading}" Grid.Column="1"
                                                  MaxWidth="720"
                                                  HorizontalAlignment="Stretch"
                                                  IsShowBadge="True"
                                                  IsSearch="True"
                                                  MenuType="App"
                                                  Data="{Binding WeekData}"
                                                  ClickCommand="{Binding ToDetailCommand}" />
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <Grid ColumnDefinitions="*,420">
                                <timeline:ClockRing HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="420"
                                                    MaxHeight="420"
                                                    Thickness="30"
                                                    Margin="0,0,14,0"
                                                    IsLoading="{Binding IsLoading}"
                                                    Segments="{Binding MonthClock.Segments}"
                                                    TickMode="{Binding MonthClock.TickMode}"
                                                    RangeStart="{Binding MonthClock.RangeStart}"
                                                    RangeEnd="{Binding MonthClock.RangeEnd}"
                                                    UseCategoryColor="{Binding UseCategoryColor}"
                                                    CenterText="{Binding MonthClock.CenterText}"
                                                    CenterCaption="{Binding MonthClock.CenterCaption}"
                                                    EmptyText="{DynamicResource NoData}"
                                                    TextBrush="{DynamicResource StandardTextBrush}"
                                                    MutedTextBrush="{DynamicResource SubTextBrush}"
                                                    TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                                    ClickCommand="{Binding ToDetailCommand}" />
                                <Charts:ListChart IsLoading="{Binding IsLoading}" Grid.Column="1"
                                                  MaxWidth="720"
                                                  HorizontalAlignment="Stretch"
                                                  IsShowBadge="True"
                                                  IsSearch="True"
                                                  MenuType="App"
                                                  Data="{Binding MonthData}"
                                                  ClickCommand="{Binding ToDetailCommand}" />
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <Grid ColumnDefinitions="*,420">
                                <timeline:ClockRing HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="420"
                                                    MaxHeight="420"
                                                    Thickness="30"
                                                    Margin="0,0,14,0"
                                                    IsLoading="{Binding IsLoading}"
                                                    Segments="{Binding YearClock.Segments}"
                                                    TickMode="{Binding YearClock.TickMode}"
                                                    RangeStart="{Binding YearClock.RangeStart}"
                                                    RangeEnd="{Binding YearClock.RangeEnd}"
                                                    UseCategoryColor="{Binding UseCategoryColor}"
                                                    CenterText="{Binding YearClock.CenterText}"
                                                    CenterCaption="{Binding YearClock.CenterCaption}"
                                                    EmptyText="{DynamicResource NoData}"
                                                    TextBrush="{DynamicResource StandardTextBrush}"
                                                    MutedTextBrush="{DynamicResource SubTextBrush}"
                                                    TrackBrush="{DynamicResource MultiTrackRowBorderBrush}"
                                                    ClickCommand="{Binding ToDetailCommand}" />
                                <Charts:ListChart IsLoading="{Binding IsLoading}" Grid.Column="1"
                                                  MaxWidth="720"
                                                  HorizontalAlignment="Stretch"
                                                  IsShowBadge="True"
                                                  IsSearch="True"
                                                  MenuType="App"
                                                  Data="{Binding YearData}"
                                                  ClickCommand="{Binding ToDetailCommand}" />
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- B：时段分布柱图 -->
                    <Border Grid.Row="3" Classes="insightCard" Height="176"
                            IsVisible="{Binding IsDistributionVisible}">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,0">
                                <TextBlock Classes="cardTitle" Text="{DynamicResource InsightDistribution}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.BucketTotalText}"
                                               Foreground="{DynamicResource DefaultTextBrush}" />
                                    <TextBlock Classes="cardCaption" Text="{Binding CurrentInsight.CompareCaption}" />
                                </StackPanel>
                            </Grid>
                            <Charts:StackedBarChart Grid.Row="1" Margin="16,6,16,8"
                                                    IsLoading="{Binding IsLoading}"
                                                    Series="{Binding CurrentInsight.HourSeries}"
                                                    Labels="{Binding CurrentInsight.HourLabels}"
                                                    CompareValues="{Binding CurrentInsight.CompareValues}"
                                                CompareBrush="{DynamicResource ChartCompareBrush}"
                                                    EmptyText="{DynamicResource NoData}"
                                                    TextBrush="{DynamicResource SubTextBrush}"
                                                    MutedTextBrush="{DynamicResource SubTextBrush}"
                                                    AxisBrush="{DynamicResource WindowBorderBrush}"
                                                    HoverBrush="{DynamicResource HoverBackgroundBrush}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 右侧洞察栏：C 使用习惯 / D 热力图 / E 分类占比（外包 ScrollViewer 防止年度 12 行热力图在紧凑窗口被压缩） -->
                <ScrollViewer Grid.Column="1" Width="400" Margin="14,0,0,0"
                              IsVisible="{Binding IsInsightVisible}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto">

                    <!-- C：使用习惯 -->
                    <Border Classes="insightCard">
                        <StackPanel Margin="16,12,16,14">
                            <TextBlock Classes="cardTitle" Text="{DynamicResource InsightHabits}"
                                       Margin="0,0,0,10" />

                            <ItemsControl ItemsSource="{Binding CurrentInsight.Habits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:InsightHabitRow">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                            <TextBlock FontSize="12" Text="{Binding Label}"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="habitValue" Text="{Binding Value}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,6">
                                <TextBlock FontSize="11" Text="{DynamicResource InsightBands}"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CurrentInsight.Bands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:InsightBand">
                                        <Grid ColumnDefinitions="40,Auto,*" Margin="0,0,0,5">
                                            <TextBlock FontSize="11" Text="{Binding Name}"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Width="96" Height="6" CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource MultiTrackRowBorderBrush}">
                                                <Border HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource ThemeBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="11" Margin="8,0,0,0"
                                                       Text="{Binding ShareText}"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- D：热力图 -->
                    <Border Grid.Row="1" Classes="insightCard" Margin="0,12,0,12">
                        <Grid RowDefinitions="Auto,Auto,*" Margin="16,12,16,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" Text="{DynamicResource InsightHeatmap}" />
                                <TextBlock Grid.Column="1" Classes="cardCaption"
                                           VerticalAlignment="Center"
                                           Text="{Binding CurrentInsight.Heatmap.PeakText}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Classes="cardCaption" Margin="0,2,0,8"
                                       Text="{Binding CurrentInsight.Heatmap.Caption}" />

                            <Charts:HeatGrid Grid.Row="2"
                                             IsLoading="{Binding IsLoading}"
                                             Rows="{Binding CurrentInsight.Heatmap.Rows}"
                                             ColumnLabels="{Binding CurrentInsight.Heatmap.ColumnLabels}"
                                             MaxValue="{Binding CurrentInsight.Heatmap.MaxValue}"
                                             RowLabelWidth="76"
                                             SquareCells="{Binding CurrentInsight.Heatmap.IsCalendar}"
                                             EmptyText="{DynamicResource NoData}"
                                             AccentBrush="{DynamicResource ThemeBrush}"
                                             TextBrush="{DynamicResource DefaultTextBrush}"
                                             MutedTextBrush="{DynamicResource SubTextBrush}"
                                             HoverBrush="{DynamicResource HoverBackgroundBrush}" />
                        </Grid>
                    </Border>

                    <!-- E：分类占比 -->
                    <Border Grid.Row="2" Classes="insightCard" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,*" Margin="16,12,16,14">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Classes="cardTitle" Text="{DynamicResource InsightCategoryShare}" />
                                <TextBlock Grid.Column="1" Classes="cardCaption"
                                           VerticalAlignment="Center"
                                           Text="{Binding CurrentInsight.CategoryCaption}" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                                <Charts:DonutChart Width="104" Height="104"
                                                   Thickness="12"
                                                   VerticalAlignment="Center"
                                                   IsLoading="{Binding IsLoading}"
                                                   Series="{Binding CurrentInsight.CategorySeries}"
                                                   CenterText="{Binding CurrentInsight.CategoryTotalText}"
                                                   CenterCaption="{Binding CurrentInsight.CategoryCaption}"
                                                   EmptyText="{DynamicResource NoData}"
                                                   TextBrush="{DynamicResource DefaultTextBrush}"
                                                   MutedTextBrush="{DynamicResource SubTextBrush}"
                                                   TrackBrush="{DynamicResource Surface3Brush}" />

                                <ScrollViewer Grid.Column="1" Margin="12,0,0,0"
                                              Padding="0,0,6,0"
                                              MaxHeight="168"
                                              VerticalAlignment="Center"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding CurrentInsight.CategorySeries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="chartModels:ChartsDataModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,5">
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Color, Converter={StaticResource HextoColorConverter}}" />
                                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource DefaultTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" FontSize="11"
                                                               FontFeatures="tnum"
                                                               Margin="6,0,0,0"
                                                               Text="{Binding Tag}"
                                                               Foreground="{DynamicResource SubTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 悬浮展开按钮：头部收起时悬浮在页面右上角留白处，不占用布局、不遮挡内容 -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,6,0"
                Padding="2"
                CornerRadius="8"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                ZIndex="50"
                Opacity="{Binding IsHeaderExpanded, Converter={StaticResource InverseOpacityConverter}}"
                IsHitTestVisible="{Binding !IsHeaderExpanded}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.225">
                        <DoubleTransition.Easing>
                            <CubicEaseInOut />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Border.Transitions>
            <Button:IconButton Width="24" Height="24" FontSize="11"
                               Foreground="{DynamicResource DefaultTextBrush}"
                               Icon="ChevronDownMed"
                               ToolTip.Tip="{DynamicResource ExpandHeader}"
                               Command="{Binding ToggleHeaderCommand}" />
        </Border>
    </Grid>
</control:TPage>
