<c:TPage xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:behaviors="using:ShiJian.Client.Behaviors"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
         xmlns:list="using:ShiJian.Client.Controls.List"
         xmlns:Button="using:ShiJian.Client.Controls.Button"
         xmlns:input="using:ShiJian.Client.Controls.Input"
         xmlns:select="using:ShiJian.Client.Controls.Select"
         xmlns:base="using:ShiJian.Client.Controls.Base"
             xmlns:cat="using:ShiJian.Client.Controls.Category"
         xmlns:toggle="using:ShiJian.Client.Controls.Toggle"
         xmlns:vm="using:ShiJian.Client.ViewModels"
         xmlns:models="using:ShiJian.Client.Models"
         xmlns:lib="using:ShiJian.Client.Librarys"
         xmlns:c="using:ShiJian.Client.Controls"
         x:DataType="vm:CategoryPageViewModel"
         IsFillPage="True"
         x:Class="ShiJian.Client.Views.CategoryPage">
    <c:TPage.Resources>
        <!-- 共享分类打标签浮层（N5）：全列表共用一个 Flyout，避免为每行实例化 Popup -->
        <Flyout x:Key="TagPickerFlyout" Placement="BottomEdgeAlignedRight">
            <StackPanel x:DataType="vm:CategoryPageViewModel" MinWidth="190" MaxWidth="250" Spacing="4">
                <StackPanel.Styles>
                    <Style Selector="Button.tagOption">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.tagOption:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ListItemCardHoverBgBrush}" />
                    </Style>
                    <Style Selector="Button.tagOption:pressed">
                        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
                    </Style>
                </StackPanel.Styles>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TagPickerOptions}" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="lib:CategoryTagOption">
                                <Button Classes="tagOption"
                                        Tag="{Binding}"
                                        Click="OnTagOptionClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <base:Img Grid.Column="0" Width="14" Height="14" DecodeWidth="14"
                                                  URL="{Binding Icon}"
                                                  Foreground="{Binding Color, Converter={StaticResource HextoColorConverter}}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                   Foreground="{DynamicResource StandardTextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="✓" FontSize="11"
                                                   Foreground="{DynamicResource ThemeBrush}"
                                                   IsVisible="{Binding IsSelected}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Height="1" Background="{DynamicResource DividerSubtleBrush}" Margin="0,2" />
                <Button Classes="tagOption"
                        HorizontalContentAlignment="Left"
                        Click="OnTagNewCategoryClicked">
                    <TextBlock Text="{DynamicResource NewCategory}" FontSize="12"
                               Foreground="{DynamicResource ThemeBrush}" />
                </Button>
            </StackPanel>
        </Flyout>
    </c:TPage.Resources>

    <Grid>
        <base:PageModal IsOpen="{Binding EditVisibility}"
                        CloseCommand="{Binding EditCloseCommand}">
            <Border x:Name="EditBorder" Width="420" MaxHeight="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Background="{DynamicResource PopupBackgroundBrush}"
                    CornerRadius="{StaticResource RadiusLarge}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource Elevation3}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <base:Text Content="{DynamicResource ExCreateEdit}" Value="{Binding IsCreate}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource SideSort}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button:IconButton Foreground="{DynamicResource SubTextBrush}"
                                           Icon="ChromeClose"
                                           HorizontalAlignment="Right"
                                           FontSize="12" Margin="0,0,10,0"
                                           Command="{Binding EditCloseCommand}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Grid.Row="1" x:Name="viewer">
                        <StackPanel Margin="10">
                            <TextBlock Text="{DynamicResource ClassificationName}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <base:ColorSelect Color="{Binding EditColor,Mode=TwoWay}"
                                                  ToolTip.Tip="{DynamicResource SelectCategoryColors}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,10,0,0" />

                                <input:InputBox Grid.Column="1" Error="{Binding EditErrorText}"
                                                IsShowError="{Binding IsEditError,Mode=TwoWay}"
                                                Text="{Binding EditName,Mode=TwoWay}"
                                                MaxLength="10" Margin="5,10,0,0"
                                                Placeholder="{DynamicResource PleaseEnterCategoryName}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Icon}" Margin="0,10,0,0" />
                            <base:IconSelect URL="{Binding EditIconFile,Mode=TwoWay}"
                                             HorizontalAlignment="Left"
                                             Margin="0,10,0,0" />
                            <StackPanel IsVisible="{Binding !IsSysCategory}">
                                <Border Margin="0,10,0,0">
                                    <toggle:Toggle
                                        IsChecked="{Binding EditIsDirectoryMatch,Mode=TwoWay}" TextPosition="Left"
                                        OnText="{DynamicResource DirectoryMatch}"
                                        OffText="{DynamicResource DirectoryMatch}" />
                                </Border>
                                <base:View Condition="True" Value="{Binding EditIsDirectoryMatch}">
                                    <StackPanel Margin="0,10,0,0">
                                        <Button:Button HorizontalAlignment="Right" Width="100"
                                                       Command="{Binding AddDirectoryCommand}"
                                                       Content="{DynamicResource AddDirectory}" />
                                        <list:BaseList Items="{Binding EditDirectories,Mode=OneWay}"
                                                       SelectedItem="{Binding EditSelectedDirectory,Mode=TwoWay}">
                                            <list:BaseList.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Remove}"
                                                              Command="{Binding DirectoriesCommand}"
                                                              CommandParameter="remove" />
                                                </ContextMenu>
                                            </list:BaseList.ContextMenu>
                                        </list:BaseList>
                                    </StackPanel>
                                </base:View>

                                <Border Margin="0,10,0,0">
                                    <toggle:Toggle
                                        IsChecked="{Binding EditIsUrlMatch,Mode=TwoWay}" TextPosition="Left"
                                        OnText="{DynamicResource UrlMatch}"
                                        OffText="{DynamicResource UrlMatch}" />
                                </Border>
                                <base:View Condition="True" Value="{Binding EditIsUrlMatch}">
                                    <StackPanel Margin="0,10,0,0">
                                        <Button:Button HorizontalAlignment="Right" Width="100"
                                                       Command="{Binding AddUrlPatternCommand}"
                                                       Content="{DynamicResource AddUrlPattern}" />
                                        <list:BaseList Items="{Binding EditUrlPatterns,Mode=OneWay}"
                                                       SelectedItem="{Binding EditSelectedUrlPattern,Mode=TwoWay}">
                                            <list:BaseList.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Remove}"
                                                              Command="{Binding UrlPatternsCommand}"
                                                              CommandParameter="remove" />
                                                </ContextMenu>
                                            </list:BaseList.ContextMenu>
                                        </list:BaseList>
                                    </StackPanel>
                                </base:View>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Button:Button Grid.Row="2" HorizontalAlignment="Right" Text="{DynamicResource ExCreateUpdate}"
                                   Value="{Binding IsCreate}" Width="120" Margin="0,10,16,14" VerticalAlignment="Center"
                                   Command="{Binding EditDoneCommand}" />
                </Grid>
            </Border>
        </base:PageModal>

        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource AutoClassify}" Command="{Binding ApplyAutoClassifyCommand}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
                </ContextMenu>
            </Grid.ContextMenu>

            <StackPanel Margin="0,8,0,14" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource SideSort}" FontSize="18" VerticalAlignment="Center" />
                        <select:TabSwitch Margin="12,0,0,0" VerticalAlignment="Center"
                                       IsShowIcon="False" SelectedItem="{Binding BrowseMode,Mode=TwoWay}"
                                       Options="{Binding BrowseModeOptions}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button:Button Icon="Accept"
                                   Content="{DynamicResource AutoClassify}"
                                   ToolTip.Tip="{DynamicResource AutoClassifyTip}"
                                   Padding="12,0"
                                   Margin="0,0,10,0"
                                   Command="{Binding ApplyAutoClassifyCommand}" />
                        <Button:Button Icon="CalculatorAddition"
                                   Content="{DynamicResource NewCategory}"
                                   Width="150"
                                   Command="{Binding EditCommand}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            IsVisible="{Binding IsCategoryBrowseMode}">
                    <TextBlock Text="{DynamicResource SortOrder}" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <select:TabSwitch Margin="0,0,16,0" VerticalAlignment="Center"
                                   ToolTip.Tip="{DynamicResource SortOrder}"
                                   IsShowIcon="False" SelectedItem="{Binding SortMode,Mode=TwoWay}"
                                   Options="{Binding SortOptions}" />
                    <TextBlock Text="{DynamicResource ViewMode}" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <select:TabSwitch VerticalAlignment="Center"
                                   ToolTip.Tip="{DynamicResource ViewMode}"
                                   IsShowIcon="False" SelectedItem="{Binding ViewMode,Mode=TwoWay}"
                                   Options="{Binding ViewModeOptions}" />
                </StackPanel>
            </StackPanel>

            <!-- 统一分类卡片视图（BrowseMode == 0，含空分类折叠 N7-c + 应用网站共享标签 N8） -->
            <ScrollViewer Grid.Row="1"
                          Margin="0,6,0,0"
                          IsVisible="{Binding IsCategoryBrowseMode}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <base:EmptyData IsVisible="{Binding !HasAnyAppCategories}" IsLoading="{Binding IsLoading}" />

                    <ListBox Margin="10,12,10,0" ItemsSource="{Binding ActiveAppCategories}"
                             IsVisible="{Binding HasActiveAppCategories}"
                             Classes="categoryList" Classes.card="{Binding IsCardView}"
                             SelectedItem="{Binding SelectedAppCategoryItem,Mode=TwoWay}"
                             PointerPressed="OnAppCategoryListBoxPointerPressed"
                             behaviors:KeyboardListActivation.EnterCommand="{Binding GotoListCommand}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <Interaction.Behaviors>
                            <EventTriggerBehavior EventName="PointerReleased">
                                <InvokeCommandAction Command="{Binding GotoListCommand}"
                                                     CommandParameter="{Binding SelectedAppCategoryItem}" />
                            </EventTriggerBehavior>
                        </Interaction.Behaviors>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource ViewCategorySummary}"
                                          Command="{Binding GotoListCommand}"
                                          CommandParameter="{Binding SelectedAppCategoryItem}" />
                                <MenuItem Header="{DynamicResource ViewCategoryAppList}"
                                          Command="{Binding GotoAppListCommand}"
                                          CommandParameter="{Binding SelectedAppCategoryItem}" />
                                <MenuItem Header="{DynamicResource ViewWebsiteList}"
                                          Command="{Binding GotoWebListCommand}"
                                          CommandParameter="{Binding SelectedAppCategoryItem}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Edit}" Command="{Binding EditCommand}"
                                          CommandParameter="{Binding SelectedAppCategoryItem}" />
                                <MenuItem Header="{DynamicResource ReApplyDirectoryMatch}"
                                          Command="{Binding ApplyDirectoryMatchCommand}"
                                          IsVisible="{Binding SelectedAppCategoryItem.Data.IsDirectoryMatch, FallbackValue=False}" />
                                <MenuItem Header="{DynamicResource ReApplyUrlMatch}"
                                          Command="{Binding ApplyUrlMatchCommand}"
                                          IsVisible="{Binding SelectedAppCategoryItem.Data.IsUrlMatch, FallbackValue=False}" />
                                <MenuItem Header="{DynamicResource DeleteCategory}" Command="{Binding DelCommand}"
                                          IsVisible="{Binding !SelectedAppCategoryItem.Data.IsSystem, FallbackValue=False}"
                                          CommandParameter="{Binding SelectedAppCategoryItem}" />
                                <MenuItem Header="{DynamicResource RestoreSystemCategory}"
                                          Command="{Binding RestoreSystemCategoryCommand}"
                                          IsVisible="{Binding SelectedAppCategoryItem.Data.IsSystem, FallbackValue=False}"
                                          CommandParameter="{Binding SelectedAppCategoryItem}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter x:Name="PART_ContentPresenter"
                                                          Background="Transparent"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter>
                                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:focus /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:focus-visible">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="^:focus-visible cat|CategoryCard">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                                </Style>
                            </Style>
                            <Style Selector="ListBox">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel>
                                    <Interaction.Behaviors>
                                        <behaviors:AdaptiveWrapBehavior MinItemWidth="188" />
                                    </Interaction.Behaviors>
                                </WrapPanel>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <cat:CategoryCard />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空分类折叠区（N7-c 尾项） -->
                    <StackPanel IsVisible="{Binding HasEmptyAppCategories}" Margin="10,16,10,12">
                        <Button Background="Transparent" BorderThickness="0" Padding="4,6"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding ToggleAppEmptyExpandedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="▸" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                           IsVisible="{Binding !IsAppEmptyExpanded}" VerticalAlignment="Center" />
                                <TextBlock Text="▾" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                           IsVisible="{Binding IsAppEmptyExpanded}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AppEmptyHeaderText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border x:Name="EmptyAppCategoriesHost" IsVisible="False" Height="0" Opacity="1">
                            <ListBox Margin="0,6,0,0" ItemsSource="{Binding EmptyAppCategories}"
                                     Classes="categoryList" Classes.card="{Binding IsCardView}"
                                     SelectedItem="{Binding SelectedAppCategoryItem,Mode=TwoWay}"
                                     PointerPressed="OnAppCategoryListBoxPointerPressed"
                                     behaviors:KeyboardListActivation.EnterCommand="{Binding GotoListCommand}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <Interaction.Behaviors>
                                    <EventTriggerBehavior EventName="PointerReleased">
                                        <InvokeCommandAction Command="{Binding GotoListCommand}"
                                                             CommandParameter="{Binding SelectedAppCategoryItem}" />
                                    </EventTriggerBehavior>
                                </Interaction.Behaviors>

                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource ViewCategorySummary}"
                                                  Command="{Binding GotoListCommand}"
                                                  CommandParameter="{Binding SelectedAppCategoryItem}" />
                                        <MenuItem Header="{DynamicResource ViewCategoryAppList}"
                                                  Command="{Binding GotoAppListCommand}"
                                                  CommandParameter="{Binding SelectedAppCategoryItem}" />
                                        <MenuItem Header="{DynamicResource ViewWebsiteList}"
                                                  Command="{Binding GotoWebListCommand}"
                                                  CommandParameter="{Binding SelectedAppCategoryItem}" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Edit}" Command="{Binding EditCommand}"
                                                  CommandParameter="{Binding SelectedAppCategoryItem}" />
                                        <MenuItem Header="{DynamicResource ReApplyDirectoryMatch}"
                                                  Command="{Binding ApplyDirectoryMatchCommand}"
                                                  IsVisible="{Binding SelectedAppCategoryItem.Data.IsDirectoryMatch, FallbackValue=False}" />
                                        <MenuItem Header="{DynamicResource ReApplyUrlMatch}"
                                                  Command="{Binding ApplyUrlMatchCommand}"
                                                  IsVisible="{Binding SelectedAppCategoryItem.Data.IsUrlMatch, FallbackValue=False}" />
                                        <MenuItem Header="{DynamicResource DeleteCategory}" Command="{Binding DelCommand}"
                                                  IsVisible="{Binding !SelectedAppCategoryItem.Data.IsSystem, FallbackValue=False}"
                                                  CommandParameter="{Binding SelectedAppCategoryItem}" />
                                        <MenuItem Header="{DynamicResource RestoreSystemCategory}"
                                                  Command="{Binding RestoreSystemCategoryCommand}"
                                                  IsVisible="{Binding SelectedAppCategoryItem.Data.IsSystem, FallbackValue=False}"
                                                  CommandParameter="{Binding SelectedAppCategoryItem}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>

                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                                  Background="Transparent"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </ControlTemplate>
                                        </Setter>
                                        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:focus /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="^:focus-visible">
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                        <Style Selector="^:focus-visible cat|CategoryCard">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                                        </Style>
                                    </Style>
                                    <Style Selector="ListBox">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>
                                </ListBox.Styles>

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel>
                                            <Interaction.Behaviors>
                                                <behaviors:AdaptiveWrapBehavior MinItemWidth="188" />
                                            </Interaction.Behaviors>
                                        </WrapPanel>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <cat:CategoryCard />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 应用 / 网站明细视图（BrowseMode == 1，N5：搜索过滤排序 + 快速打标签） -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsEntityBrowseMode}">
                <!-- 搜索 / 类型 / 筛选 / 排序工具条 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,12">
                    <input:InputBox Grid.Column="0"
                                    Icon="Search"
                                    Text="{Binding EntitySearchInput, Mode=TwoWay}"
                                    Placeholder="{DynamicResource EntitySearchPlaceholder}" />
                    <select:TabSwitch Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsShowIcon="False"
                                      SelectedItem="{Binding EntityTypeMode, Mode=TwoWay}"
                                      Options="{Binding EntityTypeOptions}" />
                    <select:TabSwitch Grid.Column="2"
                                      VerticalAlignment="Center"
                                      IsShowIcon="False"
                                      SelectedItem="{Binding EntityFilterMode, Mode=TwoWay}"
                                      Options="{Binding EntityFilterOptions}" />
                    <select:Select Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Height="32" Padding="10,0"
                                   SelectedItem="{Binding EntitySortMode, Mode=TwoWay}"
                                   Options="{Binding EntitySortOptions}" />
                </Grid>

                <!-- 实体列表区 -->
                <Grid Grid.Row="1">
                    <base:EmptyData IsVisible="{Binding !HasFilteredEntities}" IsLoading="{Binding IsLoading}" />

                    <ListBox x:Name="EntityListBox"
                             ItemsSource="{Binding FilteredEntities}"
                             IsVisible="{Binding HasFilteredEntities}"
                             SelectedItem="{Binding SelectedEntityItem, Mode=TwoWay}"
                             PointerPressed="OnEntityListBoxPointerPressed"
                             behaviors:KeyboardListActivation.EnterCommand="{Binding GotoEntityDetailCommand}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <Interaction.Behaviors>
                            <EventTriggerBehavior EventName="PointerReleased">
                                <InvokeCommandAction Command="{Binding GotoEntityDetailCommand}"
                                                     CommandParameter="{Binding SelectedEntityItem}" />
                            </EventTriggerBehavior>
                        </Interaction.Behaviors>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource View}"
                                          Command="{Binding GotoEntityDetailCommand}"
                                          CommandParameter="{Binding SelectedEntityItem}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Styles>
                            <Style Selector="ListBox">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border x:Name="EntityCardBorder"
                                                Height="156"
                                                Margin="4"
                                                Padding="12,10"
                                                CornerRadius="8"
                                                Background="{DynamicResource CardBgBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter x:Name="PART_ContentPresenter"
                                                              Background="Transparent"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:focus /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:focus-visible">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="^:focus-visible /template/ Border#EntityCardBorder">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                                </Style>
                                <Style Selector="^:pointerover /template/ Border#EntityCardBorder">
                                    <Setter Property="Background" Value="{DynamicResource ListItemCardHoverBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ListItemCardHoverBorderBrush}" />
                                </Style>
                                <Style Selector="^:pressed /template/ Border#EntityCardBorder">
                                    <Setter Property="Background" Value="{DynamicResource ListItemPressedBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ListItemCardHoverBorderBrush}" />
                                </Style>
                                <Style Selector="^:selected /template/ Border#EntityCardBorder">
                                    <Setter Property="Background" Value="{DynamicResource ListItemSelectedBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                                </Style>
                                <Style Selector="^:selected:pointerover /template/ Border#EntityCardBorder">
                                    <Setter Property="Background" Value="{DynamicResource ListItemSelectedHoverBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
                                </Style>
                            </Style>
                            <Style Selector="Button.tagPill">
                                <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="Button.tagPill:pointerover">
                                <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ListItemCardHoverBorderBrush}" />
                            </Style>
                            <Style Selector="Button.tagPill:pressed">
                                <Setter Property="Background" Value="{DynamicResource ListItemCardHoverBgBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel>
                                    <Interaction.Behaviors>
                                        <behaviors:AdaptiveWrapBehavior MinItemWidth="188" />
                                    </Interaction.Behaviors>
                                </WrapPanel>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryEntityRow">
                                <Grid RowDefinitions="Auto,Auto,Auto,*">
                                    <!-- 顶部：图标 + 类型/合并角标 -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                        <Border Width="32" Height="32" CornerRadius="8"
                                                Background="{DynamicResource Surface3Brush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <base:Img Width="22" Height="22" DecodeWidth="24" Radius="6"
                                                      URL="{Binding Icon}"
                                                      FallbackText="{Binding FallbackText}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Border Background="{DynamicResource ThemeTintBrush}"
                                                    CornerRadius="4" Padding="6,2"
                                                    IsVisible="{Binding IsMerged}"
                                                    ToolTip.Tip="{Binding MemberTooltip}">
                                                <TextBlock Text="{Binding MergedText}" FontSize="10"
                                                           Foreground="{DynamicResource ThemeBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource Surface3Brush}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                           Foreground="{DynamicResource SubTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 中部：名称与副标题 -->
                                    <StackPanel Grid.Row="1" Margin="0,6,0,0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StandardTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Subtitle}" />
                                    </StackPanel>

                                    <!-- 时长信息 -->
                                    <Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="Auto,*,Auto"
                                          VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" FontSize="11"
                                                   FontFeatures="tnum"
                                                   Foreground="{DynamicResource StandardTextBrush}">
                                            <Run Text="{DynamicResource TodayPrefix}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding TodayText}" FontWeight="Medium" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" FontSize="11"
                                                   FontFeatures="tnum"
                                                   Foreground="{DynamicResource SubTextBrush}">
                                            <Run Text="{DynamicResource TotalPrefix}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding TotalText}" />
                                        </TextBlock>
                                    </Grid>

                                    <!-- 底部：快速打标签胶囊按钮，点击就地弹出共享分类选择器，不触发卡片导航 -->
                                    <Button Classes="tagPill"
                                            Grid.Row="3"
                                            Margin="0,8,0,0"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Tag="{Binding}"
                                            Click="OnTagPillClicked"
                                            PointerReleased="OnTagPillPointerReleased">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding CategoryColor, Converter={StaticResource HextoColorConverter}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="11.5"
                                                       Foreground="{DynamicResource StandardTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="▾" FontSize="10"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</c:TPage>
