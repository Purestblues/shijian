<c:TPage xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:behaviors="using:ShiJian.Client.Behaviors"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
         xmlns:base="using:ShiJian.Client.Controls.Base"
         xmlns:select="using:ShiJian.Client.Controls.Select"
         xmlns:input="using:ShiJian.Client.Controls.Input"
         xmlns:c="using:ShiJian.Client.Controls"
         Foreground="{DynamicResource StandardTextBrush}"
         xmlns:model="using:ShiJian.Client.ViewModels"
         xmlns:shared="using:ShiJian.Client.Shared.Models"
         xmlns:Button="clr-namespace:ShiJian.Client.Controls.Button"
         x:DataType="model:CategoryAppListPageViewModel"
         IsFillPage="TRUE"
         x:Class="ShiJian.Client.Views.CategoryAppListPage">
    <Grid>
        <base:PageModal IsOpen="{Binding ChooseVisibility}"
                        CloseCommand="{Binding ChooseCloseCommand}">
            <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="{StaticResource RadiusLarge}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource Elevation3}"
                    Width="560" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="{DynamicResource SelectiveApplication}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <Button:IconButton Foreground="{DynamicResource SubTextBrush}" Icon="ChromeClose"
                                           HorizontalAlignment="Right" FontSize="12" Margin="0,0,10,0"
                                           Command="{Binding ChooseCloseCommand}" />
                    </Grid>
                    <Border Grid.Row="1">
                        <input:InputBox Placeholder="{DynamicResource SearchApplication}" Margin="10"
                                        x:Name="SearchBox"
                                        Text="{Binding SearchInput,Mode=TwoWay}">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="KeyUp">
                                    <InvokeCommandAction Command="{Binding SearchCommand}"
                                                         CommandParameter="{Binding #SearchBox.Text}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                        </input:InputBox>
                    </Border>

                    <ListBox ItemsSource="{Binding AppList}"
                             Margin="20,0" Grid.Row="2">
                        <ListBox.Styles>
                            <Style Selector="ListBox">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ScrollViewer>
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </Setter>
                            </Style>

                            <Style Selector="ListBoxItem">
                                <Setter Property="Width" Value="240" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border>
                                            <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Content="{TemplateBinding Content}" />
                                        </Border>

                                    </ControlTemplate>
                                </Setter>

                                <Style Selector="^:pointerover /template/ Border">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>

                                <Style Selector="^:selected /template/ Border">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>

                                <Style Selector="^:pointerover /template/ Border ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>

                                <Style Selector="^:selected /template/ Border ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <select:Option HorizontalAlignment="Stretch"
                                               IsChecked="{Binding IsChoosed,Mode=TwoWay}"
                                               Value="{Binding Value}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button:Button Grid.Row="3"
                                   HorizontalAlignment="Right"
                                   Content="{DynamicResource Complete}" Width="120" Margin="0,12,12,14"
                                   VerticalAlignment="Center"
                                   Command="{Binding ChoosedCommand}" />
                </Grid>

            </Border>
        </base:PageModal>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,20">
                <Button Classes="subtle breadcrumb-root"
                        Margin="-6,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding GoBackCommand}">
                    <TextBlock FontSize="18" Text="{DynamicResource AppClassification}" />
                </Button>
                <base:Icon IconType="ChevronRightMed" Margin="8,0,10,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                <TextBlock FontSize="18" Text="{Binding Category.Data.Name}" VerticalAlignment="Center" />

            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource AppList}" VerticalAlignment="Center" />
                <input:InputBox Grid.Column="2"
                                Placeholder="{DynamicResource Search}"
                                Width="200"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="{Binding MainSearchInput, Mode=TwoWay}" />
                <Button:Button Grid.Column="3"
                               Content="{DynamicResource Select}"
                               Width="150"
                               Command="{Binding ShowChooseCommand}" />
            </Grid>

            <base:View Grid.Row="2" Condition="empty" Value="{Binding Data}">
                <base:EmptyData IsLoading="{Binding IsLoading}" />
            </base:View>

            <base:View Grid.Row="2" Condition="not empty" Value="{Binding Data}">
                <Border Classes="card" Margin="0,16,0,0" ClipToBounds="True">
                    <ListBox x:Name="AppListBox"
                             ItemsSource="{Binding Data}"
                             behaviors:KeyboardListActivation.EnterCommand="{Binding GotoDetailCommand}"
                             SelectedItem="{Binding SelectedItem,Mode=TwoWay}"
                             PointerReleased="OnAppListPointerReleased">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource RemoveFromCategory}" Command="{Binding DelCommand}"
                                          IsVisible="{Binding !IsSystemCategory}"
                                          CommandParameter="{Binding SelectedItem}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.Styles>
                            <Style Selector="ListBox">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ScrollViewer>
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </Setter>
                            </Style>

                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border x:Name="Border"
                                                MinHeight="48"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource DividerSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                RenderTransform="scale(1)"
                                                RenderTransformOrigin="50%,50%">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.40,0,0.20,1" />
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="0.40,0,0.20,1" />
                                                </Transitions>
                                            </Border.Transitions>
                                            <ContentPresenter x:Name="PART_ContentPresenter"
                                                              Background="Transparent"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Content="{TemplateBinding Content}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter>

                                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="^:pointerover /template/ Border#Border">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                </Style>
                                <Style Selector="^:pressed /template/ Border#Border">
                                    <Setter Property="RenderTransform" Value="scale(0.992)" />
                                </Style>
                                <Style Selector="^:selected /template/ Border#Border">
                                    <Setter Property="Background" Value="{DynamicResource SelectionPillBrush}" />
                                </Style>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="shared:AppModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Background="{DynamicResource Surface3Brush}">
                                        <base:Img Width="20" Height="20"
                                                  DecodeWidth="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  URL="{Binding IconFile}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <base:View Condition="not empty" Value="{Binding Description}">
                                            <TextBlock FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource DefaultTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Description}" />
                                        </base:View>
                                        <base:View Condition="empty" Value="{Binding Description}">
                                            <TextBlock FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource DefaultTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                        </base:View>
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding File, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Text="{Binding File}" />
                                    </StackPanel>
                                    <Button:IconButton Grid.Column="2"
                                                       Icon="Delete"
                                                       Width="30" Height="30"
                                                       FontSize="13"
                                                       HandlesPointerPressed="True"
                                                       Tag="{Binding}"
                                                       PointerReleased="OnRemoveButtonPointerReleased"
                                                       ToolTip.Tip="{DynamicResource RemoveFromCategory}"
                                                       AutomationProperties.Name="{DynamicResource RemoveFromCategory}"
                                                       IsVisible="{Binding !$parent[UserControl].((model:CategoryAppListPageViewModel)DataContext).IsSystemCategory}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </base:View>
        </Grid>
    </Grid>
</c:TPage>
