<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800"
             d:DesignHeight="1050"
             xmlns:charts="using:ShiJian.Client.Controls.Charts"
             xmlns:select="using:ShiJian.Client.Controls.Select"
             xmlns:base="using:ShiJian.Client.Controls.Base"
             xmlns:model="using:ShiJian.Client.ViewModels"
             xmlns:behaviors="using:ShiJian.Client.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             x:DataType="model:ChartPageViewModel"
             x:Class="ShiJian.Client.Views.ChartPage">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- ═══ Row 0：标题 · 日期 · 周期 ═══ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,20">
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource SideStatistics}"
                           FontSize="18"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <!-- 日期导航 -->
                    <Grid VerticalAlignment="Center">
                        <base:View Condition="0" Value="{Binding TabbarSelectedIndex}">
                            <select:DateSelect Date="{Binding Date,Mode=TwoWay}" />
                        </base:View>
                        <base:View Condition="1" Value="{Binding TabbarSelectedIndex}">
                            <select:DateSelect Date="{Binding WeekDate,Mode=TwoWay}"
                                               SelectType="Week" />
                        </base:View>
                        <base:View Condition="2" Value="{Binding TabbarSelectedIndex}">
                            <select:DateSelect Date="{Binding MonthDate,Mode=TwoWay}" SelectType="Month" />
                        </base:View>
                        <base:View Condition="3" Value="{Binding TabbarSelectedIndex}">
                            <select:DateSelect Date="{Binding YearDate,Mode=TwoWay}" SelectType="Year" />
                        </base:View>
                    </Grid>

                    <!-- 周期切换 -->
                    <select:TabSwitch IsShowIcon="False"
                                      SelectedItem="{Binding SelectedPeriod,Mode=TwoWay}"
                                      Options="{Binding PeriodOptions}" />
                </StackPanel>
            </Grid>

        <!-- ═══ Row 1：统计卡片 + 时间轴 + 图表 ═══ -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Border IsVisible="{Binding HasEntityError}"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource ThemeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding EntityErrorText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Padding="10,0" Height="28"
                                Content="{DynamicResource Retry}"
                                Command="{Binding RefreshCommand}" />
                    </Grid>
                </Border>

                <StackPanel>
                            <!-- 统计卡片 -->
                            <Grid HorizontalAlignment="Stretch" Margin="0,5,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Margin="0,5,0,0" Background="{DynamicResource CardBgBrush}"
                                        Padding="10" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Background="{DynamicResource ThemeTintBrush}">
                                            <base:Icon IconType="ScreenTime" Foreground="{DynamicResource ThemeBrush}" />
                                        </Border>
                                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontFeatures="tnum">
                                                <Run Text="{Binding TotalHours}" FontSize="20"
                                                     Foreground="{DynamicResource DefaultTextBrush}" />
                                                <Run Text="{DynamicResource Hour}" FontSize="12"
                                                     Foreground="{DynamicResource SubTextBrush}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="1" Margin="0,3,0,0"
                                                       Text="{DynamicResource Total}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>
                                        <Border Grid.Column="2" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal">
                                                <base:View Condition="=1" Value="{Binding DiffTotalTimeType}">
                                                    <base:Icon VerticalAlignment="Center" IconType="ArrowUp8" FontSize="10" />
                                                </base:View>
                                                <base:View Condition="=0" Value="{Binding DiffTotalTimeType}">
                                                    <base:Icon VerticalAlignment="Center" IconType="SubtractBold" FontSize="10" />
                                                </base:View>
                                                <base:View Condition="=-1" Value="{Binding DiffTotalTimeType}">
                                                    <base:Icon VerticalAlignment="Center" IconType="ArrowDown8" FontSize="10" />
                                                </base:View>
                                                <TextBlock Text="{Binding DiffTotalTimeValue}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Margin="12,5,0,0"
                                        Background="{DynamicResource CardBgBrush}"
                                        Padding="10" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Background="{DynamicResource ThemeTintBrush}">
                                            <base:Icon IconType="Apps" Foreground="{DynamicResource ThemeBrush}" />
                                        </Border>
                                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontFeatures="tnum">
                                                <Run Text="{Binding AppCount}" FontSize="20"
                                                     Foreground="{DynamicResource DefaultTextBrush}" />
                                                <Run Text="个" FontSize="12"
                                                     Foreground="{DynamicResource SubTextBrush}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="1" Margin="0,3,0,0"
                                                       Text="{DynamicResource InsightEntities}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>
                                        <Border Grid.Column="2" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal">
                                                <base:View Condition="=1" Value="{Binding DiffAppCountType}">
                                                    <base:Icon VerticalAlignment="Center" IconType="ArrowUp8" FontSize="10" />
                                                </base:View>
                                                <base:View Condition="=0" Value="{Binding DiffAppCountType}">
                                                    <base:Icon VerticalAlignment="Center" IconType="SubtractBold" FontSize="10" />
                                                </base:View>
                                                <base:View Condition="=-1" Value="{Binding DiffAppCountType}">
                                                    <base:Icon VerticalAlignment="Center" IconType="ArrowDown8" FontSize="10" />
                                                </base:View>
                                                <TextBlock Text="{Binding DiffAppCountValue}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Margin="12,5,0,0" Background="{DynamicResource CardBgBrush}"
                                        Padding="10" CornerRadius="8"
                                        ToolTip.Tip="{Binding Top1App.Description}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Background="{DynamicResource ThemeTintBrush}">
                                            <base:Icon IconType="StockUp" Foreground="{DynamicResource ThemeBrush}" />
                                        </Border>
                                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontFeatures="tnum">
                                                <Run Text="{Binding TopHours}" FontSize="20"
                                                     Foreground="{DynamicResource DefaultTextBrush}" />
                                                <Run Text="{DynamicResource Hour}" FontSize="12"
                                                     Foreground="{DynamicResource SubTextBrush}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="1" Margin="0,3,0,0"
                                                       Text="{DynamicResource LongestUsageTime}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>
                                        <Border Grid.Column="2">
                                            <Border CornerRadius="6" VerticalAlignment="Bottom">
                                                <base:View Value="{Binding Top1App}" Condition="not null">
                                                    <base:Img URL="{Binding Top1App.IconFile}"
                                                              DecodeWidth="16"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Center"
                                                              Width="16" Height="16" />
                                                </base:View>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 图表 + 雷达 + 最为频繁 -->
                            <WrapPanel Margin="-10">
                                <i:Interaction.Behaviors>
                                    <behaviors:RowWidthBehavior RowWidth="{Binding RowWidth, Mode=TwoWay}" />
                                </i:Interaction.Behaviors>
                                <Grid Margin="10,0,0,0" Width="{Binding ColumnChartWidth}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="1" Margin="0,10,0,0"
                                            Background="{DynamicResource CardBgBrush}" Padding="20" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <charts:ColumnChart IsStack="True" MinHeight="310" ColumnSelectedIndex="{Binding ColumnSelectedIndex,Mode=TwoWay}" IsShowTotal="False" DataMaximum="{Binding DataMaximum}" NameIndexStart="{Binding NameIndexStart}" Data="{Binding Data}" IsCanColumnSelect="{Binding IsCanColumnSelect}" />

                                            <base:View Value="{Binding DayHoursSelectedTime}" Condition="not empty">
                                                <StackPanel>
                                                    <Border Margin="0,5,0,0" HorizontalAlignment="Left" Padding="10"
                                                            CornerRadius="{StaticResource RadiusMedium}"
                                                            Background="{DynamicResource Surface3Brush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <base:Icon Foreground="{DynamicResource SubTextBrush}"
                                                                       IconType="Calendar"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Foreground="{DynamicResource SubTextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding DayHoursSelectedTime}"
                                                                       FontSize="13" Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <base:View Value="{Binding DayHoursData}" Condition="not empty">
                                                        <charts:ListChart IsLoading="{Binding IsLoading}" IsSearch="True" Margin="0,5,0,0" Height="300" MenuType="App" Data="{Binding DayHoursData}" IsShowBadge="True" ClickCommand="{Binding ToDetailCommand}" />
                                                    </base:View>
                                                    <base:View Value="{Binding DayHoursData}" Condition="empty">
                                                        <base:EmptyData IsLoading="{Binding IsLoading}" />
                                                    </base:View>
                                                </StackPanel>
                                            </base:View>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 雷达图 -->
                                <Grid Margin="10,0,0,10" Width="{Binding RadarChartWidth}" Height="400"
                                      VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource Classification}" Foreground="{DynamicResource SubTextBrush}" FontSize="15"
                                               Margin="0,20,0,5" />
                                    <Border Margin="0,5,0,0" Grid.Row="1"
                                            Background="{DynamicResource CardBgBrush}"
                                            Padding="20" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <charts:RadarChartView Margin="10,20,10,10" Height="300" HorizontalAlignment="Stretch" Data="{Binding RadarData}" />
                                    </Border>
                                </Grid>

                                <!-- 最为频繁 -->
                                <Grid Margin="10,0,0,10" Width="{Binding TopListWidth}" Height="400" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource MostFrequent}" Foreground="{DynamicResource SubTextBrush}" FontSize="15"
                                               Margin="0,20,0,5" />
                                    <Border Grid.Row="1" Margin="0,5,0,0"
                                            Background="{DynamicResource CardBgBrush}"
                                            Padding="20" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <charts:ListChart IsLoading="{Binding IsLoading}" MenuType="App" Data="{Binding TopData}" ClickCommand="{Binding ToDetailCommand}" IsCanScroll="False" />
                                    </Border>
                                </Grid>
                            </WrapPanel>
                        </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
