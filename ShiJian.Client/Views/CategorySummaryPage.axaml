<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             xmlns:vm="using:ShiJian.Client.ViewModels"
             xmlns:base="using:ShiJian.Client.Controls.Base"
             xmlns:s="using:ShiJian.Client.Controls.Select"
             xmlns:conv="using:ShiJian.Client.Controls.Converters"
             xmlns:charts="using:ShiJian.Client.Controls.Charts"
             Foreground="{DynamicResource StandardTextBrush}"
             Background="Transparent"
             x:DataType="vm:CategorySummaryPageViewModel"
             x:Class="ShiJian.Client.Views.CategorySummaryPage">

    <UserControl.Styles>
        <Style Selector="Button.cat-chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerSubtleBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Button.cat-chip /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cat-chip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cat-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.cat-chip:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
        </Style>
        <Style Selector="Button.cat-chip.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush}" />
        </Style>
        <Style Selector="Button.cat-chip.active">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush}" />
        </Style>
        <Style Selector="Button.cat-chip.active TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
        </Style>

        <Style Selector="Border.diff-pill">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="20">

        <!-- 标题 + 应用/网站切换 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,20">
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource CategorySummary}"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <s:TabSwitch Grid.Column="2"
                         IsShowIcon="False"
                         VerticalAlignment="Center"
                         SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                         Options="{Binding KindOptions}" />
        </Grid>

        <!-- 分类切换标签行：窄窗口自动换行而非横向裁切 -->
        <ItemsControl ItemsSource="{Binding CurrentCategories}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CategoryChip">
                    <Button Classes="cat-chip"
                            Classes.active="{Binding IsActive}"
                            Command="{Binding $parent[UserControl].((vm:CategorySummaryPageViewModel)DataContext).SwitchCategoryCommand}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="16">

            <!-- 周期概览（统一 .statCard 四卡布局） -->
            <Grid ColumnDefinitions="*,12,*,12,*,12,*">

                <!-- 总使用时长 -->
                <Border Grid.Column="0" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Stopwatch" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource CategoryTotalUsage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="statValue" Margin="0,6,0,0"
                                   Text="{Binding TotalText}" />
                        <Border Classes="diff-pill" Margin="0,4,0,0"
                                IsVisible="{Binding IsDiffVisible}"
                                Background="{DynamicResource ThemeTintBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <base:Icon IconType="ArrowUp8" FontSize="10"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           IsVisible="{Binding DiffUp}" />
                                <base:Icon IconType="ArrowDown8" FontSize="10"
                                           Foreground="{DynamicResource DangerBrush}"
                                           IsVisible="{Binding DiffDown}" />
                                <base:Icon IconType="SubtractBold" FontSize="10"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           IsVisible="{Binding DiffFlat}" />
                                <TextBlock FontSize="11" FontFeatures="tnum"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding VsLabel}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding DiffText}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Classes="diff-pill" Height="15" Margin="0,4,0,0"
                                IsVisible="{Binding !IsDiffVisible}" />
                    </StackPanel>
                </Border>

                <!-- 活跃天数 -->
                <Border Grid.Column="2" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="Calendar" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource CategoryActiveDays}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,6,0,0"
                                    VerticalAlignment="Bottom">
                            <TextBlock Classes="statValue" Text="{Binding ActiveDays}" />
                            <TextBlock FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       Text="{DynamicResource CategoryActiveDaysUnit}" />
                        </StackPanel>
                        <TextBlock Classes="cardCaption" Margin="0,4,0,0" Height="15"
                                   Text="{Binding RangeLabel}" />
                    </StackPanel>
                </Border>

                <!-- 日均使用 -->
                <Border Grid.Column="4" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="DateTimeMirrored" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource CategoryAverageDaily}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="statValue" Margin="0,6,0,0"
                                   Text="{Binding AverageDailyText}" />
                        <TextBlock Classes="cardCaption" Margin="0,4,0,0" Height="15"
                                   Text=" " />
                    </StackPanel>
                </Border>

                <!-- 单日峰值 -->
                <Border Grid.Column="6" Classes="statCard">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <base:Icon IconType="StockUp" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="cardCaption" Text="{DynamicResource CategoryPeakDay}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="statValue" Margin="0,6,0,0"
                                   Text="{Binding PeakText}" />
                        <TextBlock Classes="cardCaption num" Margin="0,4,0,0" Height="15"
                                   Text="{Binding PeakMetaText}" />
                    </StackPanel>
                </Border>

            </Grid>

            <!-- 使用趋势 -->
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}">
                <StackPanel>
                    <Grid Margin="20,16,20,12" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource CategoryTrend}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DefaultTextBrush}" />
                            <TextBlock Text="{DynamicResource CategoryColumnHint}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <s:DateSelect Date="{Binding SelectedDate, Mode=TwoWay}"
                                          SelectType="{Binding CurrentSelectType}" />
                            <s:TabSwitch IsShowIcon="False"
                                         VerticalAlignment="Center"
                                         SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                                         Options="{Binding RangeOptions}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerSubtleBrush}" />

                    <Grid Margin="20,16,20,20">
                        <!-- 空态 / 加载态 -->
                        <base:EmptyData IsVisible="{Binding !HasData}"
                                        IsLoading="{Binding IsLoading}"
                                        Text="{DynamicResource CategoryNoData}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                        <!-- 柱状图 + 点击列展开成员 -->
                        <Grid IsVisible="{Binding HasData}"
                              RowDefinitions="Auto,*">

                            <charts:ColumnChart Grid.Row="0"
                                                Margin="0,0,0,12"
                                                IsStack="False"
                                                Height="260"
                                                IsShowTotal="False"
                                                IsShowCategory="False"
                                                IsCanColumnSelect="{Binding IsCanColumnSelect}"
                                                ColumnSelectedIndex="{Binding ColumnSelectedIndex, Mode=TwoWay}"
                                                Data="{Binding ColumnChartData}" />

                            <StackPanel Grid.Row="1">
                                <!-- 时间标签条：全选时显示周期名，点列时显示该列标签 -->
                                <base:View Condition="not empty" Value="{Binding SelectedColumnLabel}">
                                    <Border Margin="0,5,0,0" HorizontalAlignment="Left" Padding="10"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Background="{DynamicResource Surface3Brush}">
                                        <StackPanel Orientation="Horizontal">
                                            <base:Icon IconType="Calendar"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedColumnLabel}"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </base:View>

                                <base:View Value="{Binding SelectedMembers}" Condition="not empty">
                                    <charts:ListChart IsLoading="{Binding IsLoading}" IsSearch="True"
                                                      Margin="0,5,0,0"
                                                      Height="300"
                                                      IsShowBadge="True"
                                                      MenuType="{Binding MembersMenuType}"
                                                      Data="{Binding SelectedMembers}" />
                                </base:View>
                                <base:View Value="{Binding SelectedMembers}" Condition="empty">
                                    <base:EmptyData IsLoading="{Binding IsLoading}" />
                                </base:View>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
