<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             xmlns:model="using:ShiJian.Client.ViewModels"
             xmlns:models="using:ShiJian.Client.Models"
             x:DataType="model:SettingPageViewModel"
             xmlns:Btn="using:ShiJian.Client.Controls.Button"
             xmlns:select="using:ShiJian.Client.Controls.Select"
             xmlns:Tabbar="using:ShiJian.Client.Controls.Tabbar"
             xmlns:SettingPanel="using:ShiJian.Client.Controls.SettingPanel"
             xmlns:input="using:ShiJian.Client.Controls.Input"
             xmlns:base="using:ShiJian.Client.Controls.Base"
             xmlns:toggle="using:ShiJian.Client.Controls.Toggle"
             xmlns:data="using:ShiJian.Client.Shared.Models.Data"
             x:Class="ShiJian.Client.Views.SettingPage">

    <Grid Margin="24" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" MaxWidth="820">
            <TextBlock Text="{DynamicResource Settings}" FontSize="18" Margin="0,8,0,16" />
            <Tabbar:Tabbar x:Name="Tabbar"
                HorizontalAlignment="Stretch" Data="{Binding TabbarData}"
                ItemSpacing="20"
                SelectedIndex="{Binding TabbarSelectedIndex,Mode=TwoWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ContentScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="0,20,0,24">
                <!-- Tab 0：常规 -->
                <StackPanel x:Name="TabPanelGeneral" IsVisible="{Binding IsTab0Selected}">
                    <SettingPanel:SettingPanel Data="{Binding GeneralSettings,Mode=TwoWay}"
                                               IncludeGroups="基础|Basics|概览页|Overview" />
                </StackPanel>

                <!-- Tab 1：外观 -->
                <StackPanel x:Name="TabPanelAppearance" IsVisible="{Binding IsTab1Selected}">
                    <SettingPanel:SettingPanel Data="{Binding GeneralSettings,Mode=TwoWay}"
                                               IncludeGroups="外观|Appearance" />
                </StackPanel>

                <!-- Tab 2：统计与规则 -->
                <StackPanel x:Name="TabPanelTracking" IsVisible="{Binding IsTab2Selected}" Spacing="16">
                    <SettingPanel:SettingPanel Data="{Binding GeneralSettings,Mode=TwoWay}"
                                               IncludeGroups="采集与统计|Tracking" />

                    <!-- 默认浏览器（N2）：历史站点记录没有浏览器标识时归给它 -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Margin="15,14,15,14" Spacing="3">
                            <TextBlock Text="{DynamicResource DefaultBrowser}" FontSize="14" />
                            <TextBlock Text="{DynamicResource DefaultBrowserDesc}" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                            <select:Select Margin="0,10,0,0"
                                           HorizontalAlignment="Left"
                                           SelectedItem="{Binding SelectedBrowser,Mode=TwoWay}"
                                           Options="{Binding BrowserOptions}"
                                           Padding="10,0" Height="30" />
                        </StackPanel>
                    </Border>

                    <SettingPanel:SettingPanel Data="{Binding BehaviorSettings,Mode=TwoWay}" />

                    <!-- 全局快捷键 -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel.Styles>
                                <Style Selector="Border.shortcut-row">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="15,14" />
                                </Style>
                                <Style Selector="Grid.shortcut-row-grid">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                                <Style Selector="Border.shortcut-divider">
                                    <Setter Property="Height" Value="1" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="{DynamicResource DividerSubtleBrush}" />
                                </Style>
                                <Style Selector="TextBlock.shortcut-title">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground" Value="{DynamicResource StandardTextBrush}" />
                                </Style>
                                <Style Selector="TextBlock.shortcut-desc">
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                </Style>
                            </StackPanel.Styles>

                            <!-- 行 1：刷新 -->
                            <Border Classes="shortcut-row" CornerRadius="12,12,0,0">
                                <Border.Styles>
                                    <Style Selector="Border.shortcut-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="shortcut-row-grid" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                        <TextBlock Classes="shortcut-title" Text="{DynamicResource RefreshShortcut}" />
                                        <TextBlock Classes="shortcut-desc" Text="{DynamicResource RefreshShortcutDesc}" />
                                    </StackPanel>
                                    <input:KeyGestureCapture Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Placeholder="{DynamicResource PressKeysHint}"
                                                             DefaultValue="F5"
                                                             Value="{Binding RefreshShortcut, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Classes="shortcut-divider" />

                            <!-- 行 2：搜索 -->
                            <Border Classes="shortcut-row">
                                <Border.Styles>
                                    <Style Selector="Border.shortcut-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="shortcut-row-grid" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                        <TextBlock Classes="shortcut-title" Text="{DynamicResource SearchShortcut}" />
                                        <TextBlock Classes="shortcut-desc" Text="{DynamicResource SearchShortcutDesc}" />
                                    </StackPanel>
                                    <input:KeyGestureCapture Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Placeholder="{DynamicResource PressKeysHint}"
                                                             DefaultValue="Ctrl+K"
                                                             Value="{Binding SearchShortcut, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Classes="shortcut-divider" />

                            <!-- 行 3：返回上一页 -->
                            <Border Classes="shortcut-row" CornerRadius="0,0,12,12">
                                <Border.Styles>
                                    <Style Selector="Border.shortcut-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="shortcut-row-grid" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                        <TextBlock Classes="shortcut-title" Text="{DynamicResource NavigateBackShortcut}" />
                                        <TextBlock Classes="shortcut-desc" Text="{DynamicResource NavigateBackShortcutDesc}" />
                                    </StackPanel>
                                    <input:KeyGestureCapture Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Placeholder="{DynamicResource PressKeysHint}"
                                                             DefaultValue="Alt+Left"
                                                             Value="{Binding NavigateBackShortcut, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 3：数据 -->
                <StackPanel x:Name="TabPanelData" IsVisible="{Binding IsTab3Selected}" Spacing="16">
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel.Styles>
                                <Style Selector="Border.data-row">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="15,14" />
                                </Style>
                                <Style Selector="Grid.data-row-grid">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                                <Style Selector="Border.data-divider">
                                    <Setter Property="Height" Value="1" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="{DynamicResource DividerSubtleBrush}" />
                                </Style>
                                <Style Selector="TextBlock.data-title">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground" Value="{DynamicResource StandardTextBrush}" />
                                </Style>
                                <Style Selector="TextBlock.data-desc">
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                </Style>
                            </StackPanel.Styles>

                            <!-- N15a：历史记录默认永久保留 -->
                            <Border Classes="data-row" CornerRadius="12,12,0,0">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource DataRetentionPermanentTitle}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource DataRetentionPermanentDesc}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource ThemeTintBrush}"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DataRetentionPermanentBadge}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ThemeBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Classes="data-divider" />

                            <!-- 导出完整备份 (.shijian-backup) -->
                            <Border Classes="data-row">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource ExportData}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource ExportTo}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Btn:Button Grid.Column="1" Icon="Share" Content="{DynamicResource Export}"
                                                Padding="14,0" Height="32" VerticalAlignment="Center"
                                                Command="{Binding ExportDataCommand}" />
                                </Grid>
                            </Border>

                            <Border Classes="data-divider" />

                            <!-- 导入备份 (.shijian-backup) -->
                            <Border Classes="data-row">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource ImportBackup}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource ImportBackupDesc}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Btn:Button Grid.Column="1" Icon="Folder" Content="{DynamicResource ChooseBackupFile}"
                                                Padding="14,0" Height="32" VerticalAlignment="Center"
                                                Command="{Binding ImportBackupCommand}" />
                                </Grid>
                            </Border>

                            <Border Classes="data-divider" />

                            <!-- 可选表格导出 (CSV) -->
                            <Border Classes="data-row">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource ExportCsv}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource ExportCsvDesc}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource From}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding ExportDataStartMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                            <TextBlock Text="{DynamicResource To}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding ExportDataEndMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                        </StackPanel>
                                        <Btn:Button Icon="ReportDocument" Content="{DynamicResource ExportCsv}"
                                                    Padding="12,0" Height="32" Command="{Binding ExportCsvCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="data-divider" />

                            <!-- 删除数据 -->
                            <Border Classes="data-row" CornerRadius="0,0,12,12">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource DeleteData}" Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource DeletedAndUnrecoverable}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource From}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding DelDataStartMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                            <TextBlock Text="{DynamicResource To}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding DelDataEndMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                        </StackPanel>
                                        <Btn:Button Icon="Delete" Content="{DynamicResource Execute}"
                                                    Width="80" Background="{DynamicResource DangerBrush}"
                                                    Foreground="{DynamicResource OnBrandBrush}" Command="{Binding DelDataCommand}"
                                                    ToolTip.Tip="{DynamicResource DeletedAndUnrecoverable}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- WebDAV 云同步（N15.3） -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource WebDavTitle}" FontSize="14" />
                                    <TextBlock Text="{DynamicResource WebDavSubtitle}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource WebDavEnable}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                                    <toggle:Toggle IsChecked="{Binding WebDavEnabled, Mode=TwoWay}"
                                                   OnText="{DynamicResource ToggleOn}"
                                                   OffText="{DynamicResource ToggleOff}"
                                                   VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,12,220" RowDefinitions="Auto,10,Auto" >
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{DynamicResource WebDavServerUrl}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <input:InputBox Text="{Binding WebDavUrl, Mode=TwoWay}"
                                                    Placeholder="{DynamicResource WebDavServerUrlPlaceholder}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{DynamicResource WebDavRemoteFolder}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <input:InputBox Text="{Binding WebDavRemoteFolder, Mode=TwoWay}"
                                                    Placeholder="/ShiJian" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{DynamicResource WebDavUsername}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <input:InputBox Text="{Binding WebDavUsername, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{DynamicResource WebDavPassword}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <input:InputBox Text="{Binding WebDavPassword, Mode=TwoWay}"
                                                    PasswordChar="*" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,16,*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource WebDavSyncMode}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                                    <select:Select Options="{Binding WebDavSyncModeOptions}"
                                                   SelectedItem="{Binding SelectedWebDavSyncMode, Mode=TwoWay}"
                                                   MinWidth="150" />
                                </StackPanel>
                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding WebDavMergeOnSync, Mode=TwoWay}"
                                          Content="{DynamicResource WebDavMergeOnSync}"
                                          FontSize="12"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerSubtleBrush}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding WebDavStatusText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Btn:Button Icon="Accept"
                                                Content="{DynamicResource WebDavTestConnection}"
                                                Padding="12,0" Height="30" FontSize="12"
                                                IsEnabled="{Binding WebDavNotBusy}"
                                                Command="{Binding TestWebDavCommand}" />
                                    <Btn:Button Icon="DateTimeMirrored"
                                                Content="{DynamicResource WebDavRemoteBackups}"
                                                Padding="12,0" Height="30" FontSize="12"
                                                IsEnabled="{Binding WebDavNotBusy}"
                                                Command="{Binding LoadWebDavBackupsCommand}" />
                                    <Btn:Button Icon="StockUp"
                                                Content="{DynamicResource WebDavSyncNow}"
                                                Padding="12,0" Height="30" FontSize="12"
                                                IsEnabled="{Binding WebDavNotBusy}"
                                                Command="{Binding SyncWebDavCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 子母程序合并（N6）：同一个程序的不同版本 / 子进程在列表里合成一行 -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="15,14,15,4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource MergeGroups}" FontSize="14" />
                                    <TextBlock Text="{DynamicResource MergeGroupsDesc}" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Btn:Button Grid.Column="1"
                                            Icon="CalculatorAddition"
                                            Content="{DynamicResource MergeGroupNew}"
                                            Height="30" Padding="10,0" FontSize="12"
                                            VerticalAlignment="Center"
                                            Command="{Binding OpenCreateMergeGroupCommand}" />
                            </Grid>

                            <TextBlock Text="{DynamicResource MergeGroupsEmpty}" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       Margin="15,6,15,14"
                                       IsVisible="{Binding !HasMergeGroups}" />

                            <ItemsControl ItemsSource="{Binding MergeGroups}" IsVisible="{Binding HasMergeGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AppMergeGroupRow">
                                        <Border Padding="15,10"
                                                BorderBrush="{DynamicResource DividerSubtleBrush}"
                                                BorderThickness="0,1,0,0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   Foreground="{DynamicResource StandardTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource Surface3Brush}"
                                                                CornerRadius="{StaticResource RadiusSmall}"
                                                                Padding="6,1" VerticalAlignment="Center"
                                                                IsVisible="{Binding HasKindBadge}">
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                                       Foreground="{DynamicResource ThemeBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource Surface3Brush}"
                                                                CornerRadius="{StaticResource RadiusSmall}"
                                                                Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CountText}" FontSize="10"
                                                                       Foreground="{DynamicResource SubTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MembersText}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SubTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <Btn:Button Content="{DynamicResource Edit}"
                                                                Width="68" Height="30" FontSize="12"
                                                                Command="{Binding $parent[UserControl].((model:SettingPageViewModel)DataContext).OpenEditMergeGroupCommand}"
                                                                CommandParameter="{Binding}" />
                                                    <Btn:Button Content="{DynamicResource MergeGroupDissolve}"
                                                                Width="68" Height="30" FontSize="12"
                                                                Command="{Binding $parent[UserControl].((model:SettingPageViewModel)DataContext).DissolveMergeGroupCommand}"
                                                                CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Btn:Button Content="{DynamicResource MergeGroupResetAll}"
                                        HorizontalAlignment="Right" Margin="15,8,15,12"
                                        Width="100" Height="30" FontSize="12"
                                        IsVisible="{Binding HasMergeGroups}"
                                        Command="{Binding ResetMergeGroupsCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 4：关于 -->
                <StackPanel x:Name="TabPanelAbout" IsVisible="{Binding IsTab4Selected}">
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <!-- 应用信息 -->
                            <Border Padding="15,14" CornerRadius="12,12,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Image Width="32" Source="/Resources/Icons/shijian.ico"
                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="时见" FontSize="14"
                                                   Foreground="{DynamicResource StandardTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{DynamicResource Version}" FontSize="12"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                            <TextBlock Text="{Binding Version}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Btn:Button Grid.Column="2"
                                                IsVisible="{Binding CheckUpdateBtnVisibility}"
                                                Command="{Binding CheckUpdate}"
                                                VerticalAlignment="Center" Width="110"
                                                Icon="SetlockScreen" Content="{DynamicResource CheckUpdate}" />
                                </Grid>
                            </Border>

                            <Border Height="1"
                                    Background="{DynamicResource DividerSubtleBrush}" />

                            <!-- 浏览器统计插件 -->
                            <Border Padding="15,14">
                                <HyperlinkButton Command="{Binding OpenURL}"
                                                 CommandParameter="https://github.com/Purestblues/shijian/tree/main/shijian-browser-extension"
                                                 Content="{DynamicResource PlugIn}" />
                            </Border>

                            <Border Height="1"
                                    Background="{DynamicResource DividerSubtleBrush}" />

                            <!-- 开源 -->
                            <Border Padding="15,14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource OpenSource}" FontSize="14"
                                               Foreground="{DynamicResource StandardTextBrush}" />
                                    <HyperlinkButton Command="{Binding OpenURL}"
                                                     CommandParameter="https://github.com/Purestblues/shijian"
                                                     FontSize="12">
                                        https://github.com/Purestblues/shijian
                                    </HyperlinkButton>
                                </StackPanel>
                            </Border>

                            <Border Height="1"
                                    Background="{DynamicResource DividerSubtleBrush}" />

                            <!-- 讨论 -->
                            <Border Padding="15,14" CornerRadius="0,0,12,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Discuss}" FontSize="14"
                                               Foreground="{DynamicResource StandardTextBrush}" />
                                    <HyperlinkButton Command="{Binding OpenURL}"
                                                     CommandParameter="https://github.com/Purestblues/shijian/issues"
                                                     FontSize="12">
                                        https://github.com/Purestblues/shijian/issues
                                    </HyperlinkButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 手动 / 跨源合并组编辑弹窗（N2） -->
        <base:PageModal Grid.RowSpan="2"
                        IsOpen="{Binding MergeEditorVisible}"
                        CloseCommand="{Binding CloseMergeEditorCommand}">
            <Border x:Name="MergeModalRoot"
                    MaxWidth="540" MaxHeight="560"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PopupBackgroundBrush}"
                    CornerRadius="{StaticResource RadiusLarge}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource Elevation3}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="20">
                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource MergeGroupNewTitle}"
                                       FontSize="15" FontWeight="SemiBold"
                                       IsVisible="{Binding IsMergeEditorCreate}" />
                            <TextBlock Text="{DynamicResource MergeGroupEditTitle}"
                                       FontSize="15" FontWeight="SemiBold"
                                       IsVisible="{Binding !IsMergeEditorCreate}" />
                        </StackPanel>
                        <Btn:IconButton Grid.Column="1"
                                        Icon="ChromeClose"
                                        FontSize="12"
                                        Foreground="{DynamicResource SubTextBrush}"
                                        Command="{Binding CloseMergeEditorCommand}" />
                    </Grid>

                    <!-- 内容区 -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*">
                        <input:InputBox Grid.Row="0"
                                        Text="{Binding MergeEditorName, Mode=TwoWay}"
                                        MaxLength="64"
                                        Placeholder="{DynamicResource MergeGroupNamePlaceholder}"
                                        Margin="0,0,0,10" />

                        <!-- 已选成员与母项选择 -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="10,8"
                                Margin="0,0,0,10"
                                IsVisible="{Binding MergeEditorSelectedMembers.Count}">
                            <ItemsControl ItemsSource="{Binding MergeEditorSelectedMembers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MergeCandidateRow">
                                        <Border Background="{DynamicResource Surface3Brush}"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Padding="8,4" Margin="0,2,6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding TypeBadge}" FontSize="10"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource ThemeBrush}"
                                                        CornerRadius="4" Padding="5,1"
                                                        IsVisible="{Binding IsPrimary}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource MergeGroupPrimary}"
                                                               FontSize="10" Foreground="{DynamicResource OnBrandBrush}" />
                                                </Border>
                                                <Button Content="{DynamicResource MergeGroupSetPrimary}"
                                                        IsVisible="{Binding !IsPrimary}"
                                                        Padding="6,1" FontSize="10"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        Command="{Binding #MergeModalRoot.((model:SettingPageViewModel)DataContext).SetMergePrimaryCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="×"
                                                        Padding="4,0" FontSize="12"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource SubTextBrush}"
                                                        Command="{Binding #MergeModalRoot.((model:SettingPageViewModel)DataContext).ToggleMergeCandidateCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- 搜索框 -->
                        <input:InputBox Grid.Row="2"
                                        Icon="Search"
                                        Text="{Binding MergeEditorSearch, Mode=TwoWay}"
                                        Placeholder="{DynamicResource MergeGroupSearchPlaceholder}"
                                        Margin="0,0,0,8" />

                        <!-- 候选应用 + 网站列表 -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding MergeEditorCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MergeCandidateRow">
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,6"
                                                Command="{Binding #MergeModalRoot.((model:SettingPageViewModel)DataContext).ToggleMergeCandidateCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,24,*,Auto" ColumnSpacing="10">
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          IsHitTestVisible="False"
                                                          VerticalAlignment="Center" />
                                                <base:Img Grid.Column="1" Width="20" Height="20"
                                                          DecodeWidth="20"
                                                          URL="{Binding Icon}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                               Foreground="{DynamicResource SubTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="3"
                                                        Background="{DynamicResource Surface3Brush}"
                                                        CornerRadius="4" Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeBadge}" FontSize="10"
                                                               Foreground="{DynamicResource SubTextBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 底部错误提示与操作按钮 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,12,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MergeEditorError}"
                                   IsVisible="{Binding HasMergeEditorError}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Btn:Button Grid.Column="1"
                                    Content="{DynamicResource Cancel}"
                                    Width="90" Height="32"
                                    Command="{Binding CloseMergeEditorCommand}" />
                        <Btn:Button Grid.Column="2"
                                    Classes="primary"
                                    Content="{DynamicResource Save}"
                                    Width="90" Height="32"
                                    Command="{Binding SaveMergeGroupCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </base:PageModal>

        <!-- WebDAV 云端备份历史弹窗（N15.3） -->
        <base:PageModal Grid.RowSpan="2"
                        IsOpen="{Binding WebDavRemoteModalVisible}"
                        CloseCommand="{Binding CloseWebDavRemoteModalCommand}">
            <Border x:Name="WebDavModalRoot"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Width="620" MaxHeight="520"
                    Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    BoxShadow="{DynamicResource Elevation3}"
                    Padding="20">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource WebDavRemoteModalTitle}"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6"
                                Command="{Binding CloseWebDavRemoteModalCommand}">
                            <base:Icon IconType="ChromeClose" FontSize="12" />
                        </Button>
                    </Grid>

                    <Panel Grid.Row="1">
                        <TextBlock Text="{DynamicResource WebDavRemoteEmpty}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !HasWebDavRemoteBackups}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      ClipToBounds="True"
                                      IsVisible="{Binding HasWebDavRemoteBackups}">
                            <ItemsControl ItemsSource="{Binding WebDavRemoteBackups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="data:RemoteBackupItem">
                                        <Border Padding="10,8"
                                                Margin="0,0,0,6"
                                                Background="{DynamicResource Surface2Brush}"
                                                CornerRadius="8"
                                                BorderBrush="{DynamicResource DividerSubtleBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding DeviceName}" FontSize="11"
                                                                   Foreground="{DynamicResource SubTextBrush}" />
                                                        <TextBlock Text="{Binding LastModified}" FontSize="11"
                                                                   Foreground="{DynamicResource SubTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Btn:Button Grid.Column="1"
                                                            Content="{DynamicResource WebDavMergeRestore}"
                                                            Padding="10,0" Height="28" FontSize="12"
                                                            Command="{Binding #WebDavModalRoot.((model:SettingPageViewModel)DataContext).RestoreWebDavMergeCommand}"
                                                            CommandParameter="{Binding}" />
                                                <Btn:Button Grid.Column="2"
                                                            Content="{DynamicResource WebDavReplaceRestore}"
                                                            Padding="10,0" Height="28" FontSize="12"
                                                            Background="{DynamicResource DangerBrush}"
                                                            Foreground="{DynamicResource OnBrandBrush}"
                                                            Command="{Binding #WebDavModalRoot.((model:SettingPageViewModel)DataContext).RestoreWebDavReplaceCommand}"
                                                            CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>

                    <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Btn:Button Content="{DynamicResource WebDavCloseModal}"
                                    Width="90" Height="32"
                                    Command="{Binding CloseWebDavRemoteModalCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </base:PageModal>
    </Grid>
</UserControl>



